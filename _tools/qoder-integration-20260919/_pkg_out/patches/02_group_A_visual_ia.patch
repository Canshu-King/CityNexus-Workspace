+/*
+ * CityNexus — Apple-inspired design tokens + motion layer (frontend track).
+ * Additive: defines CSS custom properties and restrained motion. It does NOT
+ * change component DOM or data-testids, so the existing rendered assertions keep
+ * passing. Values follow the Qoder/GPT v6 frontend design brief.
+ */
+
+:root {
+  /* Material palette (Light) */
+  --cn-canvas: #f5f5f7;
+  --cn-surface: #ffffff;
+  --cn-secondary: #f2f2f7;
+  --cn-ink: #1d1d1f;
+  --cn-ink-secondary: #6e6e73;
+  --cn-ink-tertiary: #86868b;
+  --cn-accent: #0a66ff;
+  /* Fill for controls that carry white text. Kept at the deeper blue even in
+     dark so a button label clears AA (white on #0a66ff ≈ 4.8:1), unlike the
+     brighter #0a84ff link accent which only reaches ~3.6:1 against white. */
+  --cn-accent-solid: #0a66ff;
+  --cn-success: #248a3d;
+  --cn-warning: #b06000;
+  --cn-danger: #d70015;
+  --cn-hairline: rgba(0, 0, 0, 0.08);
+  /* Boundary for controls whose only affordance is their outline (language
+     toggle, outline buttons) — must clear 3:1 vs the page. Decorative
+     separators stay on the softer --cn-hairline. */
+  --cn-control-border: #b9bfca;
+  font-family: var(--cn-font);
+
+  /* Type scale (mobile-first) */
+  --cn-font: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
+    "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
+  --cn-fs-display: 34px;
+  --cn-fs-title: 28px;
+  --cn-fs-section: 22px;
+  --cn-fs-card: 17px;
+  --cn-fs-body: 17px;
+  --cn-fs-secondary: 15px;
+  --cn-fs-caption: 13px;
+  --cn-lh-tight: 1.14;
+  --cn-lh-body: 1.45;
+
+  /* Spacing rhythm (4 base / 8 primary) */
+  --cn-s-8: 8px;
+  --cn-s-12: 12px;
+  --cn-s-16: 16px;
+  --cn-s-20: 20px;
+  --cn-s-24: 24px;
+  --cn-s-32: 32px;
+  --cn-s-40: 40px;
+  --cn-s-48: 48px;
+  --cn-gutter: 20px;
+
+  /* Radii (unified, no coin-flip) */
+  --cn-r-control: 11px;
+  --cn-r-button: 13px;
+  --cn-r-card: 16px;
+  --cn-r-hero: 20px;
+  --cn-r-sheet: 24px;
+  --cn-r-pill: 999px;
+
+  /* Depth — restrained */
+  --cn-shadow-card: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 28px rgba(0, 0, 0, 0.06);
+  --cn-shadow-raised: 0 2px 8px rgba(0, 0, 0, 0.06), 0 18px 40px rgba(0, 0, 0, 0.1);
+
+  /* Motion tokens */
+  --cn-ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
+  --cn-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
+  --cn-ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
+  --cn-t-press: 110ms;
+  --cn-t-hover: 160ms;
+  --cn-t-state: 200ms;
+  --cn-t-reveal: 320ms;
+  --cn-t-sheet: 400ms;
+  --cn-t-reorder: 360ms;
+  --cn-t-accept: 440ms;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --cn-canvas: #000000;
+    --cn-surface: #1c1c1e;
+    --cn-secondary: #2c2c2e;
+    --cn-ink: #f5f5f7;
+    --cn-ink-secondary: #aeaeb2;
+    --cn-ink-tertiary: #8e8e93;
+    --cn-accent: #0a84ff;
+    --cn-accent-solid: #0a66ff;
+    --cn-success: #30d158;
+    --cn-warning: #ff9f0a;
+    --cn-danger: #ff453a;
+    --cn-hairline: rgba(255, 255, 255, 0.1);
+    --cn-control-border: #7c7c82;
+    --cn-shadow-card: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 28px rgba(0, 0, 0, 0.5);
+    --cn-shadow-raised: 0 2px 8px rgba(0, 0, 0, 0.5), 0 18px 40px rgba(0, 0, 0, 0.6);
+  }
+}
+
+/* Bind the V8 shell to the Apple palette + system font without touching markup:
+   existing components consume --v8-* vars, so remapping them re-skins the app. */
+.v8-product-shell {
+  --v8-canvas: var(--cn-canvas);
+  --v8-panel: var(--cn-surface);
+  --v8-ink: var(--cn-ink);
+  --v8-muted: var(--cn-ink-secondary);
+  --v8-line: var(--cn-hairline);
+  --v8-indigo: var(--cn-accent);
+  --v8-green: var(--cn-success);
+  --v8-amber: var(--cn-warning);
+  --v8-coral: var(--cn-danger);
+  font-family: var(--cn-font);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+/* Typography rhythm on the surfaces the app already renders. */
+.v8-page { background: var(--cn-canvas); }
+.v8-page h1, .v8-hero-title { font-size: var(--cn-fs-display); font-weight: 700; line-height: var(--cn-lh-tight); letter-spacing: -0.02em; }
+.v8-page h2, .v8-section-title { font-size: var(--cn-fs-title); font-weight: 700; line-height: var(--cn-lh-tight); letter-spacing: -0.015em; }
+
+/* Unify card material: solid content, restrained depth (no atmosphere floating). */
+.v8-page .v8-card,
+.v8-page .replan-card,
+.v8-page .evidence-card,
+.v8-page .map-card {
+  background: var(--cn-surface);
+  border: 1px solid var(--cn-hairline);
+  border-radius: var(--cn-r-card);
+  box-shadow: var(--cn-shadow-card);
+}
+
+/* --- Motion: transform/opacity only, GPU-friendly, capped, reduced-motion aware --- */
+
+@keyframes cn-rise {
+  from { opacity: 0; transform: translate3d(0, 10px, 0); }
+  to { opacity: 1; transform: translate3d(0, 0, 0); }
+}
+
+/* One orchestrated page-load reveal; sections stagger by <=40ms, max 4 groups. */
+.v8-page { animation: cn-rise var(--cn-t-reveal) var(--cn-ease-out) both; }
+.v8-page > * { animation: cn-rise var(--cn-t-reveal) var(--cn-ease-out) both; }
+.v8-page > *:nth-child(1) { animation-delay: 0ms; }
+.v8-page > *:nth-child(2) { animation-delay: 28ms; }
+.v8-page > *:nth-child(3) { animation-delay: 56ms; }
+.v8-page > *:nth-child(4),
+.v8-page > *:nth-child(n + 5) { animation-delay: 84ms; } /* capped: no DOM parade */
+
+/* Restrained press + hover feedback (transform only, no rotate / big shadow). */
+.v8-page button:not(.cn-no-motion):active,
+.v8-page [role="button"]:active,
+.v8-page a.v8-cta:active { transform: scale(0.985); transition: transform var(--cn-t-press) var(--cn-ease-standard); }
+.v8-page button:not(.cn-no-motion),
+.v8-page a.v8-cta,
+.v8-page .v8-card { transition: transform var(--cn-t-hover) var(--cn-ease-standard), box-shadow var(--cn-t-hover) var(--cn-ease-standard); }
+@media (hover: hover) {
+  .v8-page .v8-card:hover { transform: translateY(-1px); box-shadow: var(--cn-shadow-raised); }
+}
+
+/* Focus-visible ring (keyboard), Apple-ish soft accent. */
+.v8-page :focus-visible { outline: 2px solid var(--cn-accent); outline-offset: 2px; border-radius: var(--cn-r-control); }
+
+/* Touch targets >=44px on primary controls. */
+.v8-page button, .v8-page a.v8-cta, .v8-nav button { min-height: 44px; }
+
+@media (prefers-reduced-motion: reduce) {
+  .v8-page,
+  .v8-page > *,
+  .v8-page button, .v8-page a.v8-cta, .v8-page .v8-card {
+    animation: none !important;
+    transition: none !important;
+    transform: none !important;
+    opacity: 1 !important;
+  }
+}
+
+/* --- Today hierarchy refinement (GPT call #2): Hero -> Attention -> Timeline --- */
+/* Single-focus Now/Next Hero (GPT pass-3). One reveal group, one primary CTA. */
+.cn-now-next-hero {
+  display: flex;
+  flex-direction: column;
+  gap: var(--cn-s-8);
+  padding: 24px;
+  border: 1px solid var(--cn-hairline);
+  border-radius: 20px;
+  background: var(--cn-surface);
+  box-shadow: var(--cn-shadow-card);
+  min-height: 0;
+}
+.cn-now-next-hero .cn-hero-label {
+  display: block;
+  margin-bottom: 2px;
+  color: var(--cn-ink-tertiary);
+  font-size: var(--cn-fs-caption);
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+.cn-hero-now .cn-hero-now-place {
+  display: block;
+  color: var(--cn-ink);
+  font-size: 20px;
+  font-weight: 650;
+  line-height: 1.2;
+  overflow-wrap: anywhere;
+}
+.cn-hero-now {
+  padding-bottom: var(--cn-s-8);
+  border-bottom: 1px solid var(--cn-hairline);
+}
+.cn-hero-next-row {
+  display: block;
+  color: var(--cn-ink);
+  font-size: var(--cn-fs-title);
+  font-weight: 700;
+  line-height: var(--cn-lh-tight);
+  letter-spacing: -0.02em;
+  overflow-wrap: anywhere;
+}
+.cn-hero-meta {
+  display: block;
+  margin-top: 4px;
+  color: var(--cn-ink-secondary);
+  font-size: 15px;
+  font-weight: 500;
+  line-height: var(--cn-lh-body);
+}
+.cn-hero-cta {
+  align-self: start;
+  margin-top: var(--cn-s-8);
+  min-height: 50px;
+}
+/* The whole card reveals once; do not stagger its Now/Next/CTA children. */
+.cn-now-next-hero.cn-hero-stagger > * { animation: none; }
+
+/* Stay / anchors step down into a compact secondary strip beneath the hero. */
+.cn-hero-strip {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--cn-s-8) var(--cn-s-16);
+  margin: 10px 0 0;
+  padding: 12px 16px;
+  border: 1px solid var(--cn-hairline);
+  border-radius: var(--cn-r-card);
+  background: var(--cn-secondary);
+}
+.cn-strip-item { display: grid; gap: 2px; min-width: 0; }
+.cn-strip-item > span {
+  color: var(--cn-ink-secondary);
+  font-size: var(--cn-fs-caption);
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+.cn-strip-item > strong,
+.cn-strip-item > b {
+  color: var(--cn-ink);
+  font-size: var(--cn-fs-secondary);
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.cn-attention-band {
+  margin: 14px 0 0;
+  padding: var(--cn-s-16) var(--cn-s-20);
+  border-radius: var(--cn-r-card);
+  background: var(--cn-surface);
+  border: 1px solid var(--cn-hairline);
+  box-shadow: var(--cn-shadow-card);
+}
+.cn-attention-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--cn-s-12);
+}
+.cn-attention-head .v8-kicker { margin: 0; }
+.cn-attention-head strong {
+  font-size: var(--cn-fs-card);
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+.cn-attention-head strong.warn { color: var(--cn-danger); }
+.cn-attention-head strong.green { color: var(--cn-success); }
+.cn-attention-hint {
+  margin: 6px 0 0;
+  color: var(--cn-ink-secondary);
+  font-size: var(--cn-fs-secondary);
+  line-height: var(--cn-lh-body);
+}
+.cn-attention-cta { margin-top: var(--cn-s-12); }
+
+/* Handled history: a quiet single line, no card chrome. */
+.cn-attention-band[data-attention="handled"] {
+  padding: 6px 2px;
+  background: transparent;
+  border-color: transparent;
+  box-shadow: none;
+}
+.cn-attention-band[data-attention="handled"] .cn-attention-head {
+  align-items: center;
+}
+.cn-attention-band[data-attention="handled"] .cn-attention-head strong {
+  font-size: var(--cn-fs-secondary);
+}
+.cn-attention-band[data-attention="handled"] .cn-attention-hint {
+  display: inline;
+  margin-left: 8px;
+  font-size: var(--cn-fs-caption);
+}
+/* Nothing to attend: near-zero visual footprint — "无事就闭嘴". The element
+   stays in the DOM (rendered tests look for it) but reads as a whisper, not an
+   "all clear" monument. */
+.cn-attention-band[data-attention="clear"] {
+  padding: 2px;
+  margin: 4px 0 0;
+  background: transparent;
+  border-color: transparent;
+  box-shadow: none;
+}
+.cn-attention-band[data-attention="clear"] .cn-attention-head {
+  justify-content: flex-start;
+}
+.cn-attention-band[data-attention="clear"] .v8-kicker {
+  display: none;
+}
+.cn-attention-band[data-attention="clear"] .cn-attention-head strong {
+  font-size: var(--cn-fs-caption);
+  font-weight: 600;
+}
+/* Open attention escalates with a warm edge. */
+.cn-attention-band[data-attention="open"] {
+  border-color: rgba(215, 0, 21, 0.28);
+}
+@keyframes cn-attention-in {
+  from { opacity: 0; transform: translate3d(0, 8px, 0); }
+  to { opacity: 1; transform: none; }
+}
+.cn-attention-band[data-attention="open"] {
+  animation: cn-attention-in var(--cn-t-reveal) var(--cn-ease-out) both;
+}
+
+/* --- Live replan motion — PRESENTATION ONLY (GPT call #3) ---
+   A pure CSS response to the data-state attribute on the proposal card. This
+   does not touch, and must never touch, what counts as accepted, when a
+   disruption is resolved, or which proposal maps to which event — that logic
+   survived six truth-gate versions and is out of scope for the design line. */
+.v8-page .live-proposal {
+  transition:
+    opacity var(--cn-t-state) var(--cn-ease-standard),
+    transform var(--cn-t-state) var(--cn-ease-standard);
+}
+.v8-page .live-proposal[data-state="accepting"] {
+  opacity: 0.72;
+  transform: translate3d(0, -2px, 0);
+}
+@keyframes cn-accept-settle {
+  from { opacity: 0; transform: translate3d(0, 8px, 0); }
+  to { opacity: 1; transform: none; }
+}
+.v8-page .live-handled,
+.v8-page [data-testid="live-message"] {
+  animation: cn-accept-settle var(--cn-t-accept) var(--cn-ease-out) both;
+}
+
+/* Live single-focus IA (GPT A+): the map is compact; when a decision is active
+   it shrinks slightly so the disruption/replan rises toward the first screen. */
+.live-shell { display: block; }
+/* Live already shows the single current state; hide LiveRecovery's duplicate
+   header (kept in the DOM) so the decision, not two titles, owns the fold. */
+.live-shell > [data-testid="live-recovery"] > .v8-page-intro { display: none; }
+.cn-live-secondary {
+  display: grid;
+  gap: var(--cn-s-12);
+  margin-top: var(--cn-s-8);
+  padding-top: var(--cn-s-12);
+  border-top: 1px solid var(--cn-hairline);
+}
+.cn-live-secondary .v8-mode-chooser { box-shadow: none; }
+.cn-live-secondary .v8-live-side { gap: var(--cn-s-8); }
+.cn-live-secondary .v8-next-card,
+.cn-live-secondary .v8-comparison { box-shadow: none; }
+/* Decision-active emphasis is expressed through layout order + the separator
+   above (not opacity, which the contrast audit cannot see). */
+
+@media (max-width: 680px) {
+  .live-shell > .v8-page .v8-live-main > .v8-map-panel {
+    min-height: 240px !important;
+    height: 240px !important;
+    box-sizing: border-box !important;
+  }
+  .live-shell[data-decision-active="true"] > .v8-page .v8-live-main > .v8-map-panel {
+    min-height: 208px !important;
+    height: 208px !important;
+  }
+}
+
+/*
+ * Controlled dark-mode convergence, driven by e2e/qoder-dark-audit.spec.ts
+ * (GPT final call #1). NOT a blind 114-colour rewrite: the audit swept the
+ * reachable Today (/v8/hub) and Live (/v8/live) surfaces under emulated dark
+ * and reported exactly these classes. Most are SHELL surfaces that live outside
+ * `.v8-page` (topbar, mobile nav, copilot pill, avatar, language button) — the
+ * gap a `.v8-page`-scoped pass could not reach. Each is rebound to a theme
+ * token so light stays as-is and dark follows, and filled controls use
+ * --cn-accent-solid so white labels clear AA. Legacy / Advanced / Wallet-JSON /
+ * off-path panels are intentionally left as declared debt this pass.
+ */
+@media (prefers-color-scheme: dark) {
+  /* 1. Shell surfaces that painted a hardcoded white in dark. */
+  .v8-product-shell .v8-topbar {
+    background: var(--cn-surface) !important;
+  }
+  .v8-product-shell .v8-breadcrumb,
+  .v8-product-shell .v8-runtime,
+  .v8-product-shell .v8-icon-button {
+    color: var(--cn-ink-secondary) !important;
+  }
+  .v8-product-shell .v8-breadcrumb b { color: var(--cn-ink-tertiary) !important; }
+  .v8-product-shell .v8-breadcrumb strong { color: var(--cn-ink) !important; }
+  .v8-product-shell .v8-mobile-nav {
+    background: rgba(28, 28, 30, 0.92) !important;
+    border-top-color: var(--cn-hairline) !important;
+  }
+  .v8-product-shell .v8-mobile-nav button { color: var(--cn-ink-secondary) !important; }
+  .v8-product-shell .v8-mobile-nav button.active { color: var(--cn-accent) !important; }
+  .v8-product-shell .cn-copilot-edge {
+    background: var(--cn-surface) !important;
+    color: var(--cn-ink) !important;
+    border-color: var(--cn-hairline) !important;
+    box-shadow: var(--cn-shadow-raised) !important;
+  }
+
+  /* 2. Language button: was white fill + bright accent text. */
+  .v8-product-shell .v9-language,
+  .v8-page .v9-language {
+    background: var(--cn-secondary) !important;
+    color: var(--cn-ink) !important;
+    border-color: var(--cn-control-border) !important;
+  }
+
+  /* 3. Filled controls: deep accent so the white label clears AA in dark. */
+  .v8-product-shell .v8-avatar,
+  .v8-product-shell .v8-primary,
+  .v8-product-shell .cn-copilot-edge-mark,
+  .v8-product-shell .v9-navigate,
+  .v8-product-shell a.v9-navigate {
+    background: var(--cn-accent-solid) !important;
+    color: #fff !important;
+  }
+
+  /* 4. Content cards / rows that kept a light fill inside .v8-page. */
+  .v8-page .v8-day-card,
+  .v8-page .v8-day-detail,
+  .v8-page .v8-live-now,
+  .v8-page .v8-mode-chooser,
+  .v8-page .v8-next-card,
+  .v8-page .v8-comparison,
+  .v8-page .v8-outline-button,
+  .v8-page .v8-compare-button,
+  .v8-page .v8-rain-button,
+  .v8-page .v8-map-panel {
+    background: var(--cn-surface) !important;
+    color: var(--cn-ink) !important;
+    border-color: var(--cn-hairline) !important;
+  }
+  /* Outline buttons carry no fill — their border is the only affordance, so it
+     must clear 3:1 vs the page (unlike the decorative cards above). */
+  .v8-page .v8-outline-button {
+    border-color: var(--cn-control-border) !important;
+  }
+  .v8-page .active,
+  .v8-page .v8-mode-chooser .active {
+    background: var(--cn-secondary) !important;
+    color: var(--cn-ink) !important;
+  }
+  .v8-page .v8-map-caption {
+    background: rgba(28, 28, 30, 0.86) !important;
+    color: var(--cn-ink) !important;
+  }
+  .v8-page .v8-status-pill {
+    background: rgba(48, 209, 88, 0.16) !important;
+    color: #7bd88f !important;
+  }
+  .v8-page .mode-mark {
+    background: var(--cn-secondary) !important;
+    color: var(--cn-accent) !important;
+  }
+
+  /* 5. Hardcoded grey-blue body text that fell below AA on the dark canvas. */
+  .v8-product-shell .v8-lede,
+  .v8-product-shell .v8-muted,
+  .v8-product-shell .v8-live-now p,
+  .v8-product-shell .v8-live-now > strong,
+  .v8-product-shell .v8-mode-chooser span,
+  .v8-product-shell .v8-mode-chips button,
+  .v8-product-shell .v8-next-card p,
+  .v8-product-shell .v8-eta span,
+  .v8-product-shell .v9-evidence-summary > small {
+    color: var(--cn-ink-secondary) !important;
+  }
+  .v8-product-shell .v8-live-label { color: var(--cn-danger) !important; }
+  .v8-product-shell .v8-live-label .status-dot { background: var(--cn-danger) !important; }
+
+  .v8-page button:not([class]) {
+    background: var(--cn-surface);
+    color: var(--cn-ink);
+    border: 1px solid var(--cn-hairline);
+  }
+}
+
+/*
+ * Desktop-only sidebar (renders above 680px, so only the desktop audit reaches
+ * it) plus the Today hero's semantic status text — the remaining Today/Live
+ * surfaces the dark audit flagged. Same controlled approach: token-bind just
+ * these rendered classes.
+ */
+@media (prefers-color-scheme: dark) {
+  .v8-product-shell .v8-sidebar {
+    background: var(--cn-surface) !important;
+    border-right-color: var(--cn-hairline) !important;
+  }
+  .v8-product-shell .v8-brand strong { color: var(--cn-ink); }
+  .v8-product-shell .v8-brand span,
+  .v8-product-shell .v8-workspace-label,
+  .v8-product-shell .v8-nav-group,
+  .v8-product-shell .v8-nav button {
+    color: var(--cn-ink-secondary) !important;
+  }
+  .v8-product-shell .v8-workspace-label span { color: var(--cn-ink) !important; }
+  .v8-product-shell .v8-brand-mark {
+    background: var(--cn-accent-solid) !important;
+    color: #fff !important;
+  }
+  .v8-product-shell .v8-nav button:hover,
+  .v8-product-shell .v8-nav button.active {
+    background: var(--cn-secondary) !important;
+    color: var(--cn-ink) !important;
+  }
+  .v8-product-shell .v8-nav button.active:before { background: var(--cn-accent); }
+  .v8-product-shell .v8-sync {
+    color: #7bd88f !important;
+    border-color: var(--cn-hairline) !important;
+  }
+  .v8-product-shell .v8-sync div { color: var(--cn-ink-secondary) !important; }
+  .v8-product-shell .v8-user { color: var(--cn-ink) !important; }
+  .v8-product-shell .v8-user small { color: var(--cn-ink-secondary) !important; }
+
+  /* Today hero attention status: was a hard-coded green/amber. */
+  .v8-page .today-actions strong.green { color: #7bd88f !important; }
+  .v8-page .today-actions strong.warn { color: var(--cn-warning) !important; }
+
+  /* Live next-card green accents: hard-coded dark-on-light greens now sit on a
+     dark card surface, so they fall below AA. */
+  .v8-page .v8-next-card > span,
+  .v8-page .v8-next-card .v9-risk,
+  .v8-page .v8-next-card .v9-risk span { color: #7bd88f !important; }
+  .v8-page .v8-next-card .v9-risk b { color: var(--cn-warning) !important; }
+
+  /* Live replan surfaces (render only with a disruption, so the demo-driven
+     audit cannot reach them — migrated for coherence, declared unverified this
+     pass). They were hard-coded light tints with ink inherited from the body. */
+  .v8-page .live-disruption {
+    background: rgba(255, 159, 10, 0.12) !important;
+    border-color: rgba(255, 159, 10, 0.34) !important;
+    color: var(--cn-ink) !important;
+  }
+  .v8-page .live-proposal {
+    background: var(--cn-surface) !important;
+    border-color: var(--cn-hairline) !important;
+    color: var(--cn-ink) !important;
+  }
+  .v8-page .live-disruption b,
+  .v8-page .live-proposal b { color: var(--cn-ink) !important; }
+  .v8-page .live-summary,
+  .v8-page .live-unchanged,
+  .v8-page .live-diff { color: var(--cn-ink-secondary) !important; }
+  .v8-page .role-alert { color: #ff6961 !important; }
+  .v8-page .live-handled { color: #7bd88f !important; }
+
+  /* Mode chips: the reorder lifted them into the desktop viewport, exposing a
+     hard-coded #fff fill (a light surface in dark) and a selected state that was
+     indistinguishable from unselected. Unselected = surface + control-border
+     (unfilled control); selected = accent-solid fill + white label (a real
+     fill-difference cue, not colour alone). */
+  .v8-page .v8-mode-chips button {
+    background: var(--cn-surface) !important;
+    color: var(--cn-ink-secondary) !important;
+    border-color: var(--cn-control-border) !important;
+  }
+  .v8-page .v8-mode-chips button.active {
+    background: var(--cn-accent-solid) !important;
+    color: #fff !important;
+    border-color: transparent !important;
+  }
+}
+
