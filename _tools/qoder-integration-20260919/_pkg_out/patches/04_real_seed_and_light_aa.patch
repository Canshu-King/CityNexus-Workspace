+/* ---------------------------------------------------------------------------
+   AA-safe eyebrow text (regression fix found by axe in the real-seed
+   integration run, 2026-09-19). `.v8-kicker` inherits --v8-indigo, which the
+   Apple palette binds to --cn-accent — fine as a link, 4.42:1 as 10px text on
+   the light canvas. Page intros get the dedicated --cn-accent-text instead.
+   --------------------------------------------------------------------------- */
+.v8-page-intro .v8-kicker { color: var(--cn-accent-text); }
+
+/* An outline button has no fill, so its border is the only affordance — under
+   the light theme it was still the legacy hardcoded #d9ddea (1.2:1 on white),
+   the same failure the dark pass fixed with --cn-control-border. Fixed on both
+   sides of the theme now, decorative separators untouched. */
+.v8-page .v8-outline-button { border-color: var(--cn-control-border); }
+
+/* Hero eyebrow labels: --cn-ink-tertiary is 3.33:1 on the canvas, which fails
+   AA for 10-11px caption text. Secondary ink clears it (4.66:1) and stays
+   visually subordinate to the stop name beneath it. */
+.cn-now-next-hero .cn-hero-label { color: var(--cn-ink-secondary); }
+
+/* ---------------------------------------------------------------------------
+   Shell chrome tokenised for the light theme (found the moment the two-theme
+   contrast gate was switched on). These greys were hardcoded in styles.css at
+   1.5–3.9:1 on white: breadcrumb text and its "/" separator, the workspace
+   label, the sidebar nav group captions, the nav buttons and the language
+   toggle's outline. Under dark they were pulled in by the theme binding; under
+   light they were simply too faint, and axe/computed-style agree.
+   --------------------------------------------------------------------------- */
+.v8-breadcrumb,
+.v8-breadcrumb b,
+.v8-workspace-label,
+.v8-nav-group,
+.v8-nav button,
+.v8-runtime {
+  color: var(--cn-ink-secondary);
+}
+.v8-nav button.active,
+.v8-nav button:hover,
+.v8-page .v9-language {
+  color: var(--cn-ink);
+}
+.v9-language,
+.v8-home-language {
+  border-color: var(--cn-control-border);
+}
+
+/* ---------------------------------------------------------------------------
+   Accent-as-text and remaining sidebar chrome (light theme).
+   Rebinding --v8-indigo to Apple blue made every text consumer of it — the
+   kicker outside page intros, quiet/text buttons — drop to 4.43:1 on the
+   #f5f5f7 canvas. They now take --cn-accent-text, which is the same hue at an
+   AA-safe depth. The sidebar tagline, the sync panel, the icon button and the
+   mode chips were legacy hardcoded greys/blues that the light theme had never
+   been checked against.
+   --------------------------------------------------------------------------- */
+.v8-kicker,
+.v8-text-button,
+.v8-quiet-button,
+.v8-compare-button {
+  color: var(--cn-accent-text);
+}
+.v8-brand span,
+.v8-sync div,
+.v8-icon-button {
+  color: var(--cn-ink-secondary);
+}
+/* 4.40:1 as #248a3d on the tinted sync panel; the deeper green reads identical
+   but clears AA for 11px bold text. */
+.v8-sync {
+  color: #17672f;
+}
+/* A mode chip's border is its selection affordance, so it must clear 3:1. */
+button[data-testid^="mode-"],
+.v8-mode-option {
+  border-color: var(--cn-control-border);
+}
+
+/* The "all clear" caption is the only text in the collapsed attention band; it
+   inherits the semantic green, which as small text needed the AA-safe variant.
+   "无事就闭嘴" must not mean "say it too faintly to read". */
+.cn-attention-band[data-attention="clear"] .cn-attention-head strong {
+  color: var(--cn-success-text);
+}
diff --git a/frontend/tools/capture-visual.mjs b/frontend/tools/capture-visual.mjs
new file mode 100644
index 0000000..82654e3
--- /dev/null
+++ b/frontend/tools/capture-visual.mjs
@@ -0,0 +1,83 @@
+/**
+ * Visual-integration capture (2026-09-19).
+ *
+ * The Apple line could only ever claim *programmatic* readiness because the
+ * isolated harness had no screenshot it (and therefore nobody) could read. This
+ * script closes that gap: it renders the real seeded Today and Live surfaces at
+ * the phone widths the product is judged on, in both colour schemes, writes
+ * readable PNGs into reports/visual-integration/, and prints the computed facts
+ * (page height, whether the hero/decision reached the first screen) next to each
+ * shot so a reviewer can cross-check the picture against the numbers.
+ *
+ * Usage:
+ *   node tools/capture-visual.mjs            # uses http://127.0.0.1:4175
+ *   CITYNEXUS_E2E_BASE_URL=... node tools/capture-visual.mjs
+ */
+import { chromium } from "@playwright/test";
+import { mkdirSync } from "node:fs";
+
+const BASE = process.env.CITYNEXUS_E2E_BASE_URL ?? "http://127.0.0.1:4175";
+const STATE = "./e2e/.qoder-seed-state.json";
+const OUT = "../reports/visual-integration";
+
+const SCREENS = [
+  { name: "today", url: "/v8/hub", ready: "today-heading" },
+  { name: "live", url: "/v8/live", ready: "v8-live-journey" },
+];
+const VIEWPORTS = [
+  { name: "360x800", width: 360, height: 800 },
+  { name: "412x915", width: 412, height: 915 },
+  { name: "430x932", width: 430, height: 932 },
+  { name: "desktop1280", width: 1280, height: 900 },
+];
+const SCHEMES = ["light", "dark"];
+
+mkdirSync(OUT, { recursive: true });
+
+const browser = await chromium.launch();
+const rows = [];
+for (const screen of SCREENS) {
+  for (const vp of VIEWPORTS) {
+    for (const scheme of SCHEMES) {
+      const context = await browser.newContext({
+        viewport: { width: vp.width, height: vp.height },
+        storageState: STATE,
+        colorScheme: scheme,
+        deviceScaleFactor: 2,
+      });
+      const page = await context.newPage();
+      await page.goto(`${BASE}${screen.url}`, { waitUntil: "load" });
+      await page.getByTestId(screen.ready).first().waitFor({ timeout: 30_000 });
+      await page.waitForTimeout(1800);
+
+      const facts = await page.evaluate(() => {
+        const bodyText = document.body.innerText;
+        const kicker = document.querySelector(".v8-page-intro .v8-kicker");
+        const canvas = getComputedStyle(document.querySelector(".v8-product-shell") ?? document.body);
+        return {
+          pageHeightPx: document.documentElement.scrollHeight,
+          horizontalOverflowPx:
+            document.documentElement.scrollWidth - document.documentElement.clientWidth,
+          background: canvas.backgroundColor,
+          foreground: canvas.color,
+          kickerText: kicker ? kicker.innerText.trim().slice(0, 48) : null,
+          bodyChars: bodyText.length,
+        };
+      });
+
+      const file = `${screen.name}-${vp.name}-${scheme}.png`;
+      await page.screenshot({ path: `${OUT}/${file}`, fullPage: false });
+      await page.screenshot({ path: `${OUT}/${file.replace(".png", "-full.png")}`, fullPage: true });
+      rows.push({ screen: screen.name, vp: vp.name, scheme, file, ...facts });
+      await context.close();
+    }
+  }
+}
+await browser.close();
+
+for (const r of rows) {
+  console.log(
+    `${r.screen.padEnd(5)} ${r.vp.padEnd(13)} ${r.scheme.padEnd(5)} ${r.file.padEnd(34)} h=${String(r.pageHeightPx).padStart(5)}px overflow=${r.horizontalOverflowPx}px bg=${r.background} fg=${r.foreground} kicker="${r.kickerText ?? "-"}"`,
+  );
+}
