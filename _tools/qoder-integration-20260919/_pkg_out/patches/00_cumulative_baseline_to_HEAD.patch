+        <aside className="v8-studio-aside">
+          <div className="v8-aside-heading">
+            <span>{chosen ? t("studio.selectedStay") : t("studio.noStaySelected")}</span>
+            <button onClick={() => onNavigate("stay")}>
+              {chosen ? t("studio.change") : t("studio.chooseStay")}
