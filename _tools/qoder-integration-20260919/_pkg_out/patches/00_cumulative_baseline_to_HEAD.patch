@@ -0,0 +1,233 @@
+/**
+ * T4 — budget evidence coverage (docs/BUDGET_EVIDENCE_CONTRACT.md; V2-T4 / B4).
+ * LAYER: integration (RENDERED component), not unit.
+ *
+ * Unlike e2e/qoder-budget-evidence.spec.ts (which drives the pure functions via
+ * `page.evaluate(import .../budgetEvidence.ts)` and is labelled unit), this spec
+ * renders the real budget surface: it serves deterministic fixtures through
+ * `page.route` for every API the application actually fetches, boots the real
+ * V8Experience shell on the real `/v8/studio` route, and lets the real
+ * `Studio` feasibility block (data-testid="studio-feasibility") paint from the
+ * authoritative plan's activity cost evidence.
+ *
+ * The Studio feasibility block reads `budgetEvidenceCoverage(plan.activities)`
+ * (cost_status / estimated_cost live on the authoritative PlanVersion), and maps
+ * the coverage state to i18n copy:
+ *   FULL    -> studio.feasibilityPassed  ("行程约束检查已通过")
+ *            + studio.feasibilitySub     ("...所有站点的活动费用已完整；整趟行程
+ *                                          预算（含住宿与交通）未在此处验证。")
+ *   PARTIAL -> studio.feasibilityPassedPartial ("行程约束检查通过，费用证据不完整")
+ *            + studio.feasibilityPartialSub    ("...预算未验证：还有 {n} 站没有
+ *                                               供应商价格...")
+ *   NONE    -> studio.feasibilityPassedPartial + studio.feasibilityNoPrice
+ *
+ * What this pins, from the rendered DOM:
+ *   1. B4: everything priced EXCEPT an unknown stay/transport item -> the block
+ *      must NOT carry the FULL verdict wording; it must show the partial
+ *      "预算未验证" wording with the unknown count.
+ *   2. Only when every budget-relevant item is known does the FULL wording appear.
+ *   3. A KNOWN_FREE zero-amount stop counts as *known*, so it does not knock the
+ *      block back out of FULL (a 0 price is real evidence, not "unknown").
+ *
+ * Endpoints mocked: same set the shell boot + Studio consume; the cost evidence
+ * that drives the block is the /api/v1/journeys/{id}/plans response.
+ */
+
+import { expect, test, type Page } from "@playwright/test";
+
+const JOURNEY_ID = "e2e-render-journey";
+const TRAVELER_ID = "e2e-render-traveler";
+
+async function seed(page: Page) {
+  await page.addInitScript(() => {
+    localStorage.setItem("citynexus.v8.journey_id", "e2e-render-journey");
+    localStorage.setItem("citynexus.locale", "zh-CN");
+    try {
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      (navigator as any).serviceWorker.register = () => Promise.resolve({});
+    } catch {
+      /* no-op */
+    }
+  });
+}
+
+/** One plan activity carrying the cost evidence Studio aggregates. */
+function priced(id: string, title: string, cost_status: string, amount_minor: number) {
+  return {
+    id,
+    sequence_no: 1,
+    type: "visit",
+    title,
+    start_at: "2026-10-10T09:00:00+08:00",
+    end_at: "2026-10-10T11:00:00+08:00",
+    locked: false,
+    protected: false,
+    metadata: {},
+    cost_status,
+    estimated_cost: { amount_minor, currency: "CNY" },
+  };
+}
+
+function experienceFixture() {
+  return {
+    journey: {
+      id: JOURNEY_ID,
+      traveler_id: TRAVELER_ID,
+      title: "厦门周末",
+      city_code: "CN-XIAMEN",
+      timezone: "Asia/Shanghai",
+      start_at: "2026-10-09T18:00:00+08:00",
+      end_at: "2026-10-11T15:00:00+08:00",
+      budget: { amount_minor: 120000, currency: "CNY" },
+    },
+    trip: {
+      arrival_anchor: { at: "2026-10-09T18:00:00+08:00", location: "厦门站" },
+      departure_anchor: { at: "2026-10-11T15:00:00+08:00", location: "厦门高崎机场" },
+      party_size: 2,
+      occupancy: { adults: 2, rooms: 1 },
+      stay_budget: { amount_minor: 70000, currency: "CNY" },
+    },
+    offers: [],
+    options: [],
+    selected_option_id: null,
+    mobility_facts: [],
+    active_plan: {
+      id: "plan-1",
+      version_no: 1,
+      status: "ACTIVE",
+      source: "E2E_RENDER",
+      current_activity_id: null,
+      activities: [],
+      legs: [],
+      user_location: null,
+      disruptions: [],
+    },
+    recovery: null,
+    experience_flags: {
+      needs_review: false,
+      recovery_required: false,
+      staleness: false,
+      feasibility_failures: [],
+    },
+  };
+}
+
+function offlineFixture() {
+  return {
+    journey_id: JOURNEY_ID,
+    sequence: 1,
+    valid_until: "2026-12-31T00:00:00Z",
+    snapshot: {
+      active_plan_version_id: null,
+      current_activity_id: null,
+      next_24h: [],
+      legs: [],
+      hotel: null,
+      reservations: [],
+      read_only: true,
+      financial_actions_allowed: false,
+    },
+    provider_freshness: { latest_provider_capture_at: null, transit_realtime: "UNKNOWN" },
+    updated_at: "2026-10-09T10:00:00Z",
+  };
+}
+
+/** Authoritative plan list whose activities carry the cost evidence. */
+function plansFixture(activities: unknown[]) {
+  return [{ id: "plan-1", version_no: 1, status: "ACTIVE", activities }];
+}
+
+async function mockApi(page: Page, activities: unknown[]) {
+  await page.route(/\/api\/v1\//, (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    const send = (json: unknown) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify(json),
+      });
+    if (pathname.endsWith("/experience")) return send(experienceFixture());
+    if (pathname.endsWith("/plans")) return send(plansFixture(activities));
+    if (pathname.endsWith("/replans")) return send([]);
+    if (pathname.endsWith("/twin")) return send({ id: "twin-1", context: {} });
+    if (pathname.endsWith("/agent-policy"))
+      return send({
+        mode: "ADVISORY",
+        auto_accept_replan: false,
+        version: 1,
+        max_auto_replan_cost_delta_minor: 5000,
+        max_auto_loss_minor: 0,
+        max_auto_schedule_drift_min: 20,
+      });
+    if (pathname.endsWith("/wallet"))
+      return send({ reservations: [], commitments: [], offline_ready: true });
+    if (pathname.endsWith("/offline-snapshot")) return send(offlineFixture());
+    if (pathname.endsWith("/runtime-status")) return send({});
+    return send({});
+  });
+}
+
+test.describe("T4 budget evidence coverage (rendered integration)", () => {
+  test("B4: all stops priced but an unknown stay/transport -> the block refuses a verified-budget verdict and shows PARTIAL wording", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 3500),
+      priced("a2", "曾厝垵", "KNOWN_PAID", 1200),
+      priced("a3", "南普陀", "KNOWN_PAID", 800),
+      // The hotel and the airport transfer have no provider price.
+      priced("stay", "住宿 · 酒店", "UNKNOWN", 0),
+      priced("transport", "机场往返交通", "UNKNOWN", 0),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    // PARTIAL wording (positive assertion first, so it waits for the async plan
+    // query to resolve, then the negatives are stable).
+    await expect(block).toContainText("行程约束检查通过，费用证据不完整");
+    await expect(block).toContainText("还有 2 项缺少已验证的供应商价格");
+    // The FULL verdict wording must NOT be shown while stay/transport are unknown.
+    await expect(block).not.toContainText("行程约束检查已通过");
+  });
+
+  test("only when every budget-relevant item is known does the FULL verdict wording render", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 1000),
+      priced("a2", "环岛路骑行", "KNOWN_PAID", 2000),
+      priced("a3", "厦大参观", "KNOWN_PAID", 3000),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    await expect(block).toContainText("行程约束检查已通过");
+    await expect(block).toContainText("所有站点的活动费用已完整");
+    // None of the partial "budget not verified" wording may leak in.
+    await expect(block).not.toContainText("行程约束检查通过，费用证据不完整");
+    await expect(block).not.toContainText("站没有供应商价格");
+  });
+
+  test("a KNOWN_FREE (0 amount) stop counts as known and keeps the block at FULL", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 1000),
+      priced("free", "南普陀（免费开放）", "KNOWN_FREE", 0),
+      priced("a2", "酒店住宿", "KNOWN_PAID", 5000),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    // If a zero-amount KNOWN_FREE fell back to "unknown", coverage would be PARTIAL
+    // and the heading would read "预算未验证". Reaching FULL proves the 0 is evidence.
+    await expect(block).toContainText("行程约束检查已通过");
+    await expect(block).not.toContainText("预算未验证");
+  });
+});
diff --git a/frontend/e2e/qoder-dark-audit.spec.ts b/frontend/e2e/qoder-dark-audit.spec.ts
new file mode 100644
index 0000000..0d78b06
--- /dev/null
+++ b/frontend/e2e/qoder-dark-audit.spec.ts
@@ -0,0 +1,223 @@
+import { expect, test } from "@playwright/test";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { ensureDemoJourney, openScreen } from "./_qoderShellSeed";
+import { scanContrast, type Violation } from "./_qoderContrastScan";
+
+/**
+ * Qoder frontend track — dark-mode gate on the real Today (/v8/hub) and Live
+ * (/v8/live) surfaces (GPT calls #1 + #5). The four-tier contrast judgement
+ * lives in _qoderContrastScan.ts and is shared with the mocked Live state gate,
+ * so "0 violations" means the same thing everywhere. Legacy / Advanced /
+ * Wallet-JSON / off-path panels stay declared debt.
+ */
+
+const OUT_DIR = "../reports/dark-audit";
+
+interface AuditReport {
+  screen: string;
+  scanned: number;
+  violations: Violation[];
+  borderWarnings: number;
+}
+
+async function auditScreen(
+  page: import("@playwright/test").Page,
+  url: string,
+  readyTestIds: string[],
+  screen: string,
+  scheme: "dark" | "light" = "dark",
+): Promise<AuditReport> {
+  await page.emulateMedia({ colorScheme: scheme, media: "screen" });
+  await page.goto(url, { waitUntil: "load" });
+  for (const id of readyTestIds) {
+    await expect(page.getByTestId(id).first()).toBeVisible({ timeout: 25_000 });
+  }
+  await page.waitForTimeout(1500);
+  const scanned = await scanContrast(page, { scheme });
+  return {
+    screen,
+    scanned: scanned.count,
+    violations: scanned.rows,
+    borderWarnings: scanned.warnings,
+  };
+}
+
+interface FocusVerdict {
+  selector: string;
+  testId: string | null;
+  outlineStyle: string;
+  outlineWidth: number;
+  outlineColor: string;
+  hasRing: boolean;
+  contrast: number;
+}
+
+async function auditFocusRing(
+  page: import("@playwright/test").Page,
+): Promise<Violation[]> {
+  const violations: Violation[] = [];
+  await page.evaluate(() => (document.activeElement as HTMLElement | null)?.blur?.());
+  const seen = new Set<string>();
+  for (let i = 0; i < 22; i += 1) {
+    await page.keyboard.press("Tab");
+    const verdict = await page.evaluate(() => {
+      const parse = (value: string): [number, number, number, number] => {
+        const m = value.match(/rgba?\(([^)]+)\)/);
+        if (!m) return [0, 0, 0, value === "transparent" ? 0 : 1];
+        const p = m[1].split(",").map((x) => parseFloat(x.trim()));
+        return [p[0] || 0, p[1] || 0, p[2] || 0, p.length > 3 ? p[3] : 1];
+      };
+      const channel = (c: number) => {
+        const s = c / 255;
+        return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+      };
+      const lum = (rgb: [number, number, number]) =>
+        0.2126 * channel(rgb[0]) + 0.7152 * channel(rgb[1]) + 0.0722 * channel(rgb[2]);
+      const contrast = (a: [number, number, number], b: [number, number, number]) => {
+        const la = lum(a);
+        const lb = lum(b);
+        return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+      };
+      const backgroundUnder = (el: Element): [number, number, number] => {
+        const stack: Array<[number, number, number, number]> = [];
+        let cur: Element | null = el;
+        while (cur) {
+          const bg = parse(getComputedStyle(cur).backgroundColor);
+          if (bg[3] > 0) {
+            stack.push(bg);
+            if (bg[3] >= 0.999) break;
+          }
+          cur = cur.parentElement;
+        }
+        let acc: [number, number, number] = [0, 0, 0];
+        for (let i = stack.length - 1; i >= 0; i--) {
+          const f = stack[i];
+          acc = [f[0] * f[3] + acc[0] * (1 - f[3]), f[1] * f[3] + acc[1] * (1 - f[3]), f[2] * f[3] + acc[2] * (1 - f[3])];
+        }
+        return acc;
+      };
+      const el = document.activeElement as HTMLElement | null;
+      if (!el || el === document.body || !el.matches("button,a,input,textarea,[tabindex],[role=button]"))
+        return null;
+      const rect = el.getBoundingClientRect();
+      if (rect.width < 2 || rect.height < 2) return null;
+      const st = getComputedStyle(el);
+      const outlineWidth = parseFloat(st.outlineWidth) || 0;
+      const outlineColor = st.outlineColor === "currentcolor" ? st.color : st.outlineColor;
+      const box = st.boxShadow;
+      const hasRing = box && box !== "none";
+      const surround = backgroundUnder(el.parentElement ?? el);
+      const oc = parse(outlineColor);
+      const ringContrast =
+        st.outlineStyle !== "none" && outlineWidth > 0 && oc[3] > 0.2
+          ? contrast(
+              [oc[0] * oc[3] + surround[0] * (1 - oc[3]), oc[1] * oc[3] + surround[1] * (1 - oc[3]), oc[2] * oc[3] + surround[2] * (1 - oc[3])],
+              surround,
+            )
+          : 0;
+      const tid = el.getAttribute("data-testid");
+      const cls = (el.getAttribute("class") || "").split(/\s+/).filter(Boolean).slice(0, 2).join(".");
+      return {
+        selector: tid ? `[data-testid="${tid}"]` : `${el.tagName.toLowerCase()}${cls ? "." + cls : ""}`,
+        testId: tid,
+        outlineStyle: st.outlineStyle,
+        outlineWidth,
+        outlineColor,
+        hasRing: !!hasRing,
+        contrast: Math.round(ringContrast * 100) / 100,
+      } as FocusVerdict;
+    });
+
+    if (!verdict) continue;
+    if (seen.has(verdict.selector)) break;
+    seen.add(verdict.selector);
+
+    const indicator = verdict.outlineStyle !== "none" && verdict.outlineWidth >= 2;
+    if (!indicator && !verdict.hasRing) {
+      violations.push({
+        kind: "control-boundary",
+        selector: verdict.selector,
+        testId: verdict.testId,
+        text: "no focus indicator",
+        color: verdict.outlineColor,
+        background: "",
+        fontSizePx: 0,
+        bold: false,
+        contrast: 0,
+        required: 3,
+      });
+    } else if (indicator && verdict.contrast < 3) {
+      violations.push({
+        kind: "control-boundary",
+        selector: verdict.selector,
+        testId: verdict.testId,
+        text: `focus ring ${verdict.outlineWidth}px vs surround`,
+        color: verdict.outlineColor,
+        background: "",
+        fontSizePx: 0,
+        bold: false,
+        contrast: verdict.contrast,
+        required: 3,
+      });
+    }
+  }
+  return violations;
+}
+
+function summarise(reports: AuditReport[]): string {
+  const lines: string[] = [];
+  for (const r of reports) {
+    lines.push(`\n=== ${r.screen} (dark) — scanned ${r.scanned} nodes, ${r.violations.length} violation(s), ${r.borderWarnings} decorative-border warning(s) ===`);
+    const byKind = new Map<string, Violation[]>();
+    for (const v of r.violations) {
+      if (!byKind.has(v.kind)) byKind.set(v.kind, []);
+      byKind.get(v.kind)!.push(v);
+    }
+    for (const [kind, items] of byKind) {
+      lines.push(`  -- ${kind}: ${items.length}`);
+      for (const v of items.slice(0, 25))
+        lines.push(`     ${v.selector} "${v.text}" fg=${v.color} bg=${v.background} c=${v.contrast}/${v.required} ${v.fontSizePx}px`);
+    }
+  }
+  return lines.join("\n");
+}
+
+test.describe("Qoder dark-mode audit (Today + Live)", () => {
+  for (const vp of [
+    { width: 390, height: 844, name: "mobile" },
+    { width: 1280, height: 900, name: "desktop" },
+  ]) {
+    test(`no dark contrast violations on Today/Live (${vp.name})`, async ({ page }) => {
+      test.setTimeout(180_000);
+      await page.setViewportSize({ width: vp.width, height: vp.height });
+      await ensureDemoJourney(page);
+      // Both themes are gated. Light was previously un-gated and axe found a
+      // real 4.42:1 eyebrow text there, so "dark is clean" was never enough.
+      const reports: AuditReport[] = [];
+      for (const scheme of ["dark", "light"] as const) {
+        reports.push(
+          await auditScreen(page, "/v8/hub", ["today-heading"], `today/${vp.name}/${scheme}`, scheme),
+          await auditScreen(page, "/v8/live", ["v8-live-journey"], `live/${vp.name}/${scheme}`, scheme),
+        );
+      }
+      mkdirSync(OUT_DIR, { recursive: true });
+      writeFileSync(`${OUT_DIR}/dark-audit-${vp.name}.json`, JSON.stringify(reports, null, 2), "utf8");
+      console.log(summarise(reports));
+      const all = reports.flatMap((r) => r.violations.map((v) => `${r.screen}: ${v.kind} ${v.selector} "${v.text}"`));
+      expect(all, `contrast violations (${vp.name}):\n${all.slice(0, 40).join("\n")}`).toEqual([]);
+    });
+
+    test(`focus indicators clear 3:1 on Today/Live (${vp.name})`, async ({ page }) => {
+      test.setTimeout(120_000);
+      await page.setViewportSize({ width: vp.width, height: vp.height });
+      await page.emulateMedia({ colorScheme: "dark", media: "screen" });
+      await ensureDemoJourney(page);
+      await openScreen(page, "/v8/hub", ["today-heading"]);
+      const todayFocus = await auditFocusRing(page);
+      await openScreen(page, "/v8/live", ["v8-live-journey"]);
+      const liveFocus = await auditFocusRing(page);
+      const lines = [...todayFocus, ...liveFocus].map((v) => `${v.selector} "${v.text}" ${v.contrast}/${v.required}`);
+      expect(lines, `dark focus violations (${vp.name}):\n${lines.join("\n")}`).toEqual([]);
+    });
+  }
+});
diff --git a/frontend/e2e/qoder-live-structure.spec.ts b/frontend/e2e/qoder-live-structure.spec.ts
new file mode 100644
index 0000000..3227fd0
--- /dev/null
+++ b/frontend/e2e/qoder-live-structure.spec.ts
@@ -0,0 +1,432 @@
+import { expect, test, type Page } from "@playwright/test";
+import { scanContrast } from "./_qoderContrastScan";
+
+/**
+ * Qoder frontend track — Live state-coverage matrix (GPT pass-5, Phase 1).
+ *
+ * Before any Live restructure, light up the whole reachable Live state space
+ * with a self-contained mock (no reliance on the global journey_id seed that the
+ * isolated harness cannot provide). GPT's stop-loss: if NORMAL / UNRESOLVED /
+ * PROPOSAL_READY / ACCEPTED cannot be constructed here WITHOUT touching
+ * production state logic, we do NOT reorder Live. These fixtures only vary the
+ * /experience disruptions and the /replans proposal statuses — the same inputs
+ * real travellers' data would carry — never a product-code change to make a
+ * test easier.
+ *
+ * Each case locks a behavioural invariant the reorder must not break:
+ *   NORMAL          -> no Accept CTA
+ *   UNRESOLVED      -> disruption shown, no Accept CTA, safe "nothing to decide"
+ *   PROPOSAL_READY  -> exactly one Accept CTA for one real differing proposal
+ *   ACCEPTED        -> Accept CTA gone, handled confirmation shown
+ */
+
+const JOURNEY_ID = "e2e-live-structure";
+const TRAVELER_ID = "e2e-live-traveler";
+
+type Disruption = {
+  id: string;
+  type: string;
+  severity: string;
+  status?: string | null;
+  affected_activity_id: string | null;
+  occurred_at: string;
+};
+type Proposal = {
+  id: string;
+  status: string;
+  trigger_event_id?: string | null;
+  hard_constraints_passed: boolean;
+  locked_commitments_preserved: boolean;
+  diff: { removed?: string[]; added?: string[]; moved?: string[] };
+};
+
+function seed(page: Page) {
+  return page.addInitScript(() => {
+    localStorage.setItem("citynexus.v8.journey_id", "e2e-live-structure");
+    localStorage.setItem("citynexus.locale", "zh-CN");
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    (navigator as any).serviceWorker.register = () => Promise.resolve({});
+  });
+}
+
+function activity(id: string, title: string, start: string, end: string) {
+  return {
+    id,
+    sequence_no: 1,
+    type: "visit",
+    title,
+    start_at: start,
+    end_at: end,
+    locked: false,
+    protected: false,
+    metadata: {},
+    cost_status: "UNKNOWN",
+  };
+}
+
+function experience(disruptions: Disruption[], withActivities: boolean) {
+  return {
+    journey: {
+      id: JOURNEY_ID,
+      traveler_id: TRAVELER_ID,
+      title: "厦门周末",
+      city_code: "CN-XIAMEN",
+      timezone: "Asia/Shanghai",
+      start_at: "2026-10-09T18:00:00+08:00",
+      end_at: "2026-10-11T15:00:00+08:00",
+      budget: { amount_minor: 120000, currency: "CNY" },
+    },
+    trip: {
+      arrival_anchor: { at: "2026-10-09T18:00:00+08:00", location: "厦门站" },
+      departure_anchor: { at: "2026-10-11T15:00:00+08:00", location: "厦门高崎机场" },
+      party_size: 2,
+      occupancy: { adults: 2, rooms: 1 },
+      stay_budget: { amount_minor: 70000, currency: "CNY" },
+    },
+    offers: [],
+    options: [],
+    selected_option_id: null,
+    mobility_facts: [],
+    active_plan: {
+      id: "plan-1",
+      version_no: 1,
+      status: "ACTIVE",
+      source: "E2E_LIVE_STRUCTURE",
+      current_activity_id: withActivities ? "act-1" : null,
+      // Located activities make the Live "current"/"next" moments real; map
+      // stays in its honest empty state (no tiles, no fabricated route).
+      activities: withActivities
+        ? [
+            activity("act-1", "鼓浪屿", "2026-10-09T09:00:00+08:00", "2026-10-09T12:00:00+08:00"),
+            activity("act-2", "菽庄花园", "2026-10-09T14:30:00+08:00", "2026-10-09T16:00:00+08:00"),
+          ]
+        : [],
+      legs: [],
+      user_location: null,
+      disruptions,
+    },
+    recovery: null,
+    experience_flags: {
+      needs_review: false,
+      recovery_required: false,
+      staleness: false,
+      feasibility_failures: [],
+    },
+  };
+}
+
+function offline() {
+  return {
+    journey_id: JOURNEY_ID,
+    sequence: 1,
+    valid_until: "2026-12-31T00:00:00Z",
+    snapshot: {
+      active_plan_version_id: null,
+      current_activity_id: null,
+      next_24h: [],
+      legs: [],
+      hotel: null,
+      reservations: [],
+      read_only: true,
+      financial_actions_allowed: false,
+    },
+    provider_freshness: { latest_provider_capture_at: null, transit_realtime: "UNKNOWN" },
+    updated_at: "2026-10-09T10:00:00Z",
+  };
+}
+
+async function mockApi(page: Page, fx: { experience: unknown; replans: unknown }) {
+  await page.route(/\/api\/v1\//, (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    const send = (json: unknown) =>
+      route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(json) });
+    if (pathname.endsWith("/experience")) return send(fx.experience);
+    if (pathname.endsWith("/replans")) return send(fx.replans);
+    if (pathname.endsWith("/plans")) return send([]);
+    if (pathname.endsWith("/twin")) return send({ id: "twin-1", context: {} });
+    if (pathname.endsWith("/agent-policy"))
+      return send({ mode: "ADVISORY", auto_accept_replan: false, version: 1, max_auto_replan_cost_delta_minor: 5000, max_auto_loss_minor: 0, max_auto_schedule_drift_min: 20 });
+    if (pathname.endsWith("/wallet")) return send({ reservations: [], commitments: [], offline_ready: true });
+    if (pathname.endsWith("/offline-snapshot")) return send(offline());
+    if (pathname.endsWith("/runtime-status")) return send({});
+    if (pathname.endsWith("/execution-clock"))
+      return send({ now: "2026-10-09T10:00:00+08:00", timezone: "Asia/Shanghai", current_activity_id: null });
+    if (pathname.endsWith("/web-observations")) return send({ observations: [] });
+    return send({});
+  });
+}
+
+async function openLive(page: Page, fx: { experience: unknown; replans: unknown }) {
+  await page.setViewportSize({ width: 412, height: 915 });
+  await seed(page);
+  await mockApi(page, fx);
+  await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+  await expect(page.getByTestId("live-recovery")).toBeVisible({ timeout: 20_000 });
+}
+
+const acceptCtaCount = (page: Page) =>
+  page
+    .getByTestId("live-accept")
+    .evaluateAll((els) => els.filter((el) => (el as HTMLElement).getClientRects().length > 0).length);
+
+const CLOSURE: Disruption = {
+  id: "evt-close",
+  type: "CLOSURE",
+  severity: "HIGH",
+  status: "DETECTED",
+  affected_activity_id: "act-2",
+  occurred_at: "2026-10-09T09:30:00+08:00",
+};
+
+test.describe("Qoder Live structure order (Phase 2)", () => {
+  const rectIntersect = (
+    a: { x: number; y: number; width: number; height: number },
+    b: { x: number; y: number; width: number; height: number },
+  ) =>
+    a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
+
+  test("sections stack Current -> Map -> Disruption -> Replan (bounding rect)", async ({ page }) => {
+    const proposal: Proposal = {
+      id: "r-p1",
+      status: "PRESENTED",
+      trigger_event_id: "evt-close",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: ["菽庄花园"], added: ["厦门科技馆"], moved: [] },
+    };
+    await openLive(page, { experience: experience([CLOSURE], true), replans: [proposal] });
+
+    const tops = async (testId: string) => {
+      const loc = page.getByTestId(testId).first();
+      if ((await loc.count()) === 0) return null;
+      const box = await loc.boundingBox();
+      return box ? box.y : null;
+    };
+    const current = await tops("live-journey-current");
+    const disruption = await tops("live-disruption");
+    const replan = await tops("live-proposal");
+    const mapBox = await page.locator(".v8-map-panel").first().boundingBox();
+
+    expect(current, "current missing").not.toBeNull();
+    expect(mapBox, "map missing").not.toBeNull();
+    // Current above the map.
+    expect(current!).toBeLessThan(mapBox!.y);
+    // Map above the disruption, disruption above the replan decision.
+    expect(disruption).not.toBeNull();
+    expect(mapBox!.y + mapBox!.height).toBeLessThanOrEqual(disruption! + 1);
+    expect(replan).not.toBeNull();
+    expect(disruption!).toBeLessThan(replan!);
+
+    // Bounded mobile map: 200–270 tall, not wider than the viewport.
+    expect(mapBox!.height).toBeGreaterThanOrEqual(200);
+    expect(mapBox!.height).toBeLessThanOrEqual(270);
+    expect(mapBox!.width).toBeLessThanOrEqual(412);
+
+    // A proposal is present, so the primary Accept CTA exists and the Copilot
+    // dock must not sit on top of it (single decision centre).
+    const accept = await page.getByTestId("live-accept").first().boundingBox();
+    expect(accept, "accept CTA missing").not.toBeNull();
+    const copilot = await page.locator(".cn-copilot-edge").first().boundingBox();
+    if (copilot) {
+      expect(
+        rectIntersect(accept!, copilot),
+        `Copilot dock overlaps the Accept CTA (accept=${JSON.stringify(accept)} copilot=${JSON.stringify(copilot)})`,
+      ).toBe(false);
+    }
+  });
+});
+
+test.describe("Qoder Live accepted transition (Phase 3)", () => {
+  test("accepting a proposal surfaces the confirmation before the open warning collapses", async ({
+    page,
+  }) => {
+    await page.setViewportSize({ width: 412, height: 915 });
+    await seed(page);
