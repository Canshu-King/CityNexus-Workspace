index 0000000..31b52eb
--- /dev/null
+++ b/backend/tests/test_qoder_live_hard_fallback.py
@@ -0,0 +1,80 @@
+"""V4 #4 — a live-configured HARD capture must never launder the mock fixture.
+
+When an operator has configured a real routing provider, that provider is the
+authority.  If it fails to measure one leg:
+
+  * a *hard* replan capture (require_explicit_facts=True) has NO mock fallback,
+    so the leg stays unavailable -> the candidate becomes unavailable -> other
+    trustworthy candidates can still proceed, and only an all-untrusted result
+    reports MOBILITY_DATA_UNAVAILABLE (T2 / GPT v4 live-provider gate);
+  * a *soft* offline capture keeps the pair-level mock fallback and degrades.
+
+Before this fix the hard path silently inherited an explicit mock fixture number
+for the failed leg and let the hard replan proceed on a fabricated fact.
+"""
+
+from __future__ import annotations
+
+import types
+
+import pytest
+
+import app.integrations.mobility.runtime as runtime
+from app.integrations.mobility.snapshot_capture import MobilitySnapshotCaptureError
+
+
+class _FailingLiveProvider:
+    provider_key = "valhalla"
+
+    def __init__(self, *, failing_pairs=None, **_kwargs):
+        self.failing = set(failing_pairs or set())
+
+    def status_capabilities(self):
+        return {"status": "OK", "has_live_traffic": True}
+
+    def estimate_minutes(self, origin_key, destination_key):
+        if (origin_key, destination_key) in self.failing:
+            raise RuntimeError("live provider unavailable for leg")
+        return 5
+
+    def fact_quality(self, origin_key, destination_key):
+        return "LIVE_PROVIDER_CAPTURE"
+
+
+def _configure_live(monkeypatch, failing_pairs):
+    monkeypatch.setattr(
+        runtime, "settings", types.SimpleNamespace(live_valhalla_url="http://valhalla.test")
+    )
+    monkeypatch.setattr(runtime, "_place_lookup", lambda session, key: {"latitude": 0.0, "longitude": 0.0})
+    monkeypatch.setattr(
+        runtime,
+        "ValhallaHTTPMobilityProvider",
+        lambda **kwargs: _FailingLiveProvider(failing_pairs=failing_pairs, **{}),
+    )
+
+
+def test_live_configured_hard_capture_does_not_fall_back_to_mock(monkeypatch):
+    _configure_live(monkeypatch, {("b", "c")})
+    with pytest.raises(MobilitySnapshotCaptureError):
+        runtime.capture_runtime_mobility_snapshot(
+            None,
+            None,
+            [("a", "b"), ("b", "c")],
+            operation_key="replan:event-x",
+            require_explicit_facts=True,
+        )
+
+
+def test_live_configured_soft_capture_still_degrades_to_mock(monkeypatch):
+    _configure_live(monkeypatch, {("b", "c")})
+    result = runtime.capture_runtime_mobility_snapshot(
+        None,
+        None,
+        [("a", "b"), ("b", "c")],
+        operation_key="replan:event-y",
+        require_explicit_facts=False,
+    )
+    assert result.snapshot.degraded is True
+    # The failed leg came from the mock fallback; the good leg from the live provider.
+    assert result.snapshot.facts[("a", "b")].provider_key == "valhalla"
+    assert result.snapshot.facts[("b", "c")].provider_key == "mock-mobility"
diff --git a/backend/tests/test_qoder_live_replans_endpoint.py b/backend/tests/test_qoder_live_replans_endpoint.py
new file mode 100644
index 0000000..711ee4a
--- /dev/null
+++ b/backend/tests/test_qoder_live_replans_endpoint.py
@@ -0,0 +1,187 @@
+"""T2 v5 blocker-1 — REAL /replans path with a live provider configured.
+
+V4 closed the *primitive* (`require_explicit_facts` hard capture never falls back
+to mock) and the *offline* endpoint (no explicit fact -> refused), but GPT found
+the real bypass: ``generate_replan`` does its initial BULK mobility capture
+through the *soft* runtime path.  With a live routing provider configured, a leg
+the live provider failed would fall back to the deterministic mock, and if that
+leg happened to be an explicit demo-matrix pair it was tagged
+``EXPLICIT_FROZEN_FIXTURE`` -> accepted by ``hard_minutes()`` -> the later strict
+per-pair recapture never fired.  Two tests each green, the composition leaky.
+
+These drive the actual ``POST /api/v1/journeys/{id}/replans`` with live routing
+configured and a fake Valhalla that fails specific legs the mock still has as
+explicit fixture facts, proving the bypass is closed and candidate behaviour is
+preserved.
+
+Layer label: API/service integration (live-provider composition).
+"""
+
+from __future__ import annotations
+
+import types
+
+from fastapi.testclient import TestClient
+
+import app.integrations.mobility.runtime as runtime
+from app.main import app
+
+client = TestClient(app)
+
+# The two legs each golden same-slot replacement candidate needs (both are
+# explicit entries in data/mock/mobility_matrix.json — exactly the fixture values
+# that used to be laundered into a hard fact when the live provider failed).
+_CITY_PARK_LEGS = ("place-food-hall|place-city-park", "place-city-park|place-river-cruise")
+_DESIGN_LEGS = ("place-food-hall|place-design-library", "place-design-library|place-river-cruise")
+
+# Mutable switch so the provider can be healthy during setup (so a plan exists)
+# and degrade only at the replan call, mirroring a live outage at incident time.
+_LIVE_STATE: dict = {"failing": set(), "fail_all": False}
+
+
+class _FakeValhalla:
+    provider_key = "valhalla"
+
+    def __init__(self, **_kwargs):
+        pass
+
+    def status_capabilities(self):
+        return {"status": "OK", "has_live_traffic": False}
+
+    def estimate_minutes(self, origin_key, destination_key):
+        if _LIVE_STATE["fail_all"] or (origin_key, destination_key) in _LIVE_STATE["failing"]:
+            raise RuntimeError("live routing unavailable for leg")
+        return 12
+
+    def fact_quality(self, origin_key, destination_key):
+        return "LIVE_PROVIDER_CAPTURE"
+
+
+def _install_live(monkeypatch):
+    _LIVE_STATE["failing"] = set()
+    _LIVE_STATE["fail_all"] = False
+    monkeypatch.setattr(
+        runtime, "settings", types.SimpleNamespace(live_valhalla_url="http://valhalla.test")
+    )
+    monkeypatch.setattr(
+        runtime, "ValhallaHTTPMobilityProvider", lambda **kwargs: _FakeValhalla(**kwargs)
+    )
+
+
+def _degrade(*legs, all_legs=False):
+    _LIVE_STATE["failing"] = {tuple(p.split("|")) for p in legs}
+    _LIVE_STATE["fail_all"] = all_legs
+
+
+def _drive_to_closure():
+    ids = client.post("/api/v1/demo/reset").json()
+    jid = ids["journey_id"]
+    generated = client.post(f"/api/v1/journeys/{jid}/plans/generate", json={"candidate_count": 1})
+    assert generated.status_code == 201, generated.text
+    plan = generated.json()[0]
+    assert client.post(f"/api/v1/journeys/{jid}/plans/{plan['id']}/select").status_code == 200
+    tech = next(a for a in plan["activities"] if a["place_id"] == "place-tech-art")
+    assert client.post(f"/api/v1/journeys/{jid}/start").status_code == 200
+    for activity in plan["activities"]:
+        if activity["id"] == tech["id"]:
+            break
+        client.post(f"/api/v1/journeys/{jid}/activities/{activity['id']}/complete")
+    event = client.post(
+        f"/api/v1/journeys/{jid}/events",
+        json={
+            "event_type": "CLOSURE",
+            "severity": "MAJOR",
+            "affected_activity_id": tech["id"],
+            "occurred_at": "2026-10-10T13:25:00+08:00",
+            "payload": {"reason": "v5 live endpoint"},
+        },
+    )
+    assert event.status_code == 201, event.text
+    return jid, event.json()["id"]
+
+
+def _replan(jid, event_id, count=3):
+    return client.post(
+        f"/api/v1/journeys/{jid}/replans",
+        json={"trigger_event_id": event_id, "candidate_count": count},
+    )
+
+
+def test_live_provider_healthy_control_produces_proposal(monkeypatch) -> None:
+    _install_live(monkeypatch)
+    jid, event = _drive_to_closure()
+    assert _replan(jid, event).status_code == 201
+
+
+def test_L1_live_failure_on_mock_explicit_leg_is_not_rescued(monkeypatch) -> None:
+    # city-park's legs fail live but EXIST as explicit mock matrix facts.  design-
+    # library's legs are fine on live.  The mock must not rescue city-park: the
+    # candidate is excluded even though the matrix has a number for it, while the
+    # fully-live candidate still produces a proposal (candidate-scoped).
+    _install_live(monkeypatch)
+    jid, event = _drive_to_closure()
+    _degrade(*_CITY_PARK_LEGS)
+    response = _replan(jid, event)
+    assert response.status_code == 201, response.text
+    proposals = client.get(f"/api/v1/journeys/{jid}/replans").json()
+    added = {str((p.get("diff") or {}).get("added")) for p in proposals}
+    assert not any("place-city-park" in a for a in added), (
+        "a live-failed candidate was rescued by an explicit mock fallback: " + str(added)
+    )
+
+
+def test_L3_all_candidates_unavailable_reports_data_not_no_alternative(monkeypatch) -> None:
+    # Provider fully degraded: the failure is missing travel evidence, NOT
+    # "no replacement place exists" (REPLAN_NO_ALTERNATIVE).
+    _install_live(monkeypatch)
+    jid, event = _drive_to_closure()
+    _degrade(all_legs=True)
+    response = _replan(jid, event)
+    assert response.status_code == 422, response.text
+    assert "MOBILITY_DATA_UNAVAILABLE" in response.text, response.text
+    assert "NO_ALTERNATIVE" not in response.text, response.text
+
+
+def test_L2_fully_live_candidate_survives_when_another_is_live_failed(monkeypatch) -> None:
+    # design-library's legs fail live (mock has them explicit); city-park's legs
+    # succeed on live -> 201 offering city-park only.
+    _install_live(monkeypatch)
+    jid, event = _drive_to_closure()
+    _degrade(*_DESIGN_LEGS)
+    response = _replan(jid, event)
+    assert response.status_code == 201, response.text
+    proposals = client.get(f"/api/v1/journeys/{jid}/replans").json()
+    added = {str((p.get("diff") or {}).get("added")) for p in proposals}
+    assert any("place-city-park" in a for a in added), "trustworthy live candidate dropped: " + str(added)
+    assert not any("place-design-library" in a for a in added), (
+        "a live-failed candidate was rescued by an explicit mock fallback: " + str(added)
+    )
+
+
+def test_L4_accepted_hard_evidence_contains_no_mock_fallback(monkeypatch) -> None:
+    from app.replanning.provider_snapshots import EXPLICIT_FROZEN_FIXTURE, LIVE_PROVIDER_CAPTURE
+
+    HARD_ELIGIBLE = {EXPLICIT_FROZEN_FIXTURE, LIVE_PROVIDER_CAPTURE}
+    _install_live(monkeypatch)
+    jid, event = _drive_to_closure()
+    _degrade(*_DESIGN_LEGS)
+    assert _replan(jid, event).status_code == 201
+    proposals = client.get(f"/api/v1/journeys/{jid}/replans").json()
+    accepted = [p for p in proposals if "place-city-park" in str((p.get("diff") or {}).get("added"))]
+    assert accepted, proposals
+    facts = accepted[0]["diff"]["verified_evidence"]["mobility"]["snapshot"]["facts"]
+    # No mock-sourced fact may carry a hard-eligible quality in the accepted evidence.
+    laundered = [
+        f for f in facts
+        if f.get("provider") == "mock-mobility" and f.get("fact_quality") in HARD_ELIGIBLE
+    ]
+    assert not laundered, (
+        "a live-failed leg was laundered into hard truth via an explicit mock fallback: "
+        + str([(f.get("origin_key"), f.get("destination_key")) for f in laundered])
+    )
+    # Every city-park leg that the accepted decision relies on must be live-measured.
+    city_park_facts = [
+        f for f in facts
+        if "place-city-park" in (f.get("origin_key"), f.get("destination_key"))
+    ]
+    assert city_park_facts and all(f.get("provider") == "valhalla" for f in city_park_facts), city_park_facts
diff --git a/backend/tests/test_qoder_mobility_replan_endpoint.py b/backend/tests/test_qoder_mobility_replan_endpoint.py
new file mode 100644
index 0000000..f797a8f
--- /dev/null
+++ b/backend/tests/test_qoder_mobility_replan_endpoint.py
@@ -0,0 +1,176 @@
+"""T2 — REAL /replans endpoint path (API/service integration, B1).
+
+The v1 tests for this contract only exercised ``MockMobilityProvider(strict=True)``
+and the ``_replan_estimate`` primitive.  GPT's independent review (v2, B1) pointed
+out that the real ``generate_replan`` builds a bulk ``mobility_pairs`` set for
+replacement candidates and captures it *before* ``_replan_estimate`` runs, so a
+missing leg could be frozen at the blanket ``default_minutes=20`` and then read
+back as if it were measured — "back door locked, front door open."
+
+These tests drive the actual ``POST /api/v1/journeys/{id}/replans`` endpoint with
+a fixture in which a candidate's legs have no explicit fact (they would fall to
+the synthetic default), and assert the endpoint refuses to base a hard
+feasibility decision on that fabricated constant.
+
+Layer label (docs/TEST_AND_EVIDENCE_GATE.md): API/service integration.
+"""
+
+from __future__ import annotations
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.integrations.mock import providers as providers_mod
+from app.main import app
+
+client = TestClient(app)
+
+# Legs used by the golden same-slot replacement candidates when the tech-art
+# venue closes and the plan must route food-hall -> {candidate} -> river-cruise.
+_CANDIDATE_LEGS = (
+    "place-food-hall|place-city-park",
+    "place-city-park|place-river-cruise",
+    "place-food-hall|place-design-library",
+    "place-design-library|place-river-cruise",
+)
+
+
+@pytest.fixture()
+def _strip_explicit_legs(monkeypatch):
+    """Make named fixture pairs fall back to the blanket default (20).
+
+    Only the DATA is altered (an explicit matrix entry is deleted); no product
+    logic is patched, so the endpoint exercises its real capture + gate path.
+    """
+
+    def apply(pairs: tuple[str, ...]) -> None:
+        original_init = providers_mod.MockMobilityProvider.__init__
+
+        def patched_init(self, place_lookup=None, *, strict=False):
+            original_init(self, place_lookup, strict=strict)
+            for key in pairs:
+                self._fixture["minutes"].pop(key, None)
+
+        monkeypatch.setattr(
+            providers_mod.MockMobilityProvider, "__init__", patched_init
+        )
+
+    return apply
+
+
+def _drive_to_closure() -> tuple[str, str]:
+    ids = client.post("/api/v1/demo/reset").json()
+    jid = ids["journey_id"]
+    generated = client.post(
+        f"/api/v1/journeys/{jid}/plans/generate", json={"candidate_count": 1}
+    )
+    assert generated.status_code == 201, generated.text
+    plan = generated.json()[0]
+    assert client.post(f"/api/v1/journeys/{jid}/plans/{plan['id']}/select").status_code == 200
+    tech = next(a for a in plan["activities"] if a["place_id"] == "place-tech-art")
+    started = client.post(f"/api/v1/journeys/{jid}/start")
+    assert started.status_code == 200, started.text
+    # Advance execution to the disrupted activity's predecessor so the closure is
+    # a live, mutable replan rather than a pre-start plumbing probe.
+    for activity in plan["activities"]:
+        if activity["id"] == tech["id"]:
+            break
+        client.post(f"/api/v1/journeys/{jid}/activities/{activity['id']}/complete")
+    event = client.post(
+        f"/api/v1/journeys/{jid}/events",
+        json={
+            "event_type": "CLOSURE",
+            "severity": "MAJOR",
+            "affected_activity_id": tech["id"],
+            "occurred_at": "2026-10-10T13:25:00+08:00",
+            "payload": {"reason": "t2 endpoint truth test"},
+        },
+    )
+    assert event.status_code == 201, event.text
+    return jid, event.json()["id"]
+
+
+def test_replans_never_freezes_synthetic_default_as_hard_fact(_strip_explicit_legs) -> None:
+    """Endpoint regression 1 + 6: a missing leg is not priced at 20 as truth.
+
+    Control first: with the golden fixture intact the same closure yields a 201
+    proposal, so we know the endpoint *can* recover here and the failure below is
+    caused by the missing evidence, not by an unrelated broken setup.  Then every
+    candidate leg is forced to fall back to the blanket default.  Before V2-T2
+    the real ``generate_replan`` captured that default as a frozen ``20`` and fed
+    it to the gate; the endpoint must now fail closed with
+    ``MOBILITY_DATA_UNAVAILABLE`` instead.
+    """
+
+    # Control (fixture intact) -> a proposal is produced.
+    ctl_jid, ctl_event = _drive_to_closure()
+    control = client.post(
+        f"/api/v1/journeys/{ctl_jid}/replans",
+        json={"trigger_event_id": ctl_event, "candidate_count": 3},
+    )
+    assert control.status_code == 201, control.text
+
+    # Now strip every candidate leg and re-drive the real endpoint.
+    _strip_explicit_legs(_CANDIDATE_LEGS)
+    jid, event_id = _drive_to_closure()
+    response = client.post(
+        f"/api/v1/journeys/{jid}/replans",
+        json={"trigger_event_id": event_id, "candidate_count": 3},
+    )
+    assert response.status_code == 422, (
+        "the endpoint returned a proposal instead of failing closed — a synthetic "
+        f"default 20 likely reached hard feasibility: {response.text[:200]}"
+    )
+    assert "MOBILITY_DATA_UNAVAILABLE" in response.text, response.text
+
+
+def test_v3_03_seed_helper_neutralises_b1_sentinel(monkeypatch) -> None:
+    """V3-3 sentinel: only declared legs become hard-eligible; the rest stay missing.
+
+    Proves the narrowed seed helper did NOT turn the whole demo world into
+    "known mobility" — a pair outside the scenario table is still synthetic and
+    therefore unavailable for hard feasibility.
+    """
+
+    from _qoder_explicit_demo_mobility import seed_explicit_mobility
+    from app.integrations.mock.providers import MockMobilityProvider
+    from app.replanning.provider_snapshots import EXPLICIT_FROZEN_FIXTURE, SYNTHETIC_DEFAULT
+
+    seed_explicit_mobility(monkeypatch, {("place-food-hall", "place-city-park"): 14})
+    provider = MockMobilityProvider()
+    # Seeded, declared leg -> trustworthy explicit fact.
+    assert provider.fact_quality("place-food-hall", "place-city-park") == EXPLICIT_FROZEN_FIXTURE
+    # Undeclared pair -> still the refused blanket default, NOT laundered to known.
+    assert provider.fact_quality("place-old-town", "place-skyline-dinner") == SYNTHETIC_DEFAULT
+
+
+def test_replans_keeps_the_explicit_candidate_when_only_another_is_default(
+    _strip_explicit_legs,
+) -> None:
+    """V3-2 deterministic candidate-specific proof: A survives, B is refused.
+
+    city-park keeps its explicit fixture legs; ONLY design-library's legs are
+    stripped so it falls back to the refused default.  The endpoint must return
+    201 and offer the trustworthy city-park candidate — proving that one
+    candidate's missing evidence does not abort the whole recovery.  (The old
+    version accepted 422 as a pass, which proved nothing; this must be a 201.)
+    """
+
+    _strip_explicit_legs(
+        ("place-food-hall|place-design-library", "place-design-library|place-river-cruise")
+    )
+    jid, event_id = _drive_to_closure()
+    response = client.post(
+        f"/api/v1/journeys/{jid}/replans",
+        json={"trigger_event_id": event_id, "candidate_count": 3},
+    )
+    # Deterministic: the explicit candidate keeps recovery alive -> exactly 201.
+    assert response.status_code == 201, response.text
+    proposals = client.get(f"/api/v1/journeys/{jid}/replans").json()
+    added = {str((p.get("diff") or {}).get("added")) for p in proposals}
+    assert any("place-city-park" in a for a in added), (
+        "the candidate with trustworthy mobility was wrongly dropped: " + str(added)
+    )
+    assert not any("place-design-library" in a for a in added), (
+        "a candidate resting on refused synthetic-default mobility was offered: " + str(added)
+    )
