+function Studio({
+  data,
+  selected,
+  chosen,
+  plan,
+  onNavigate,
+  onRain,
+}: {
+  data: V8Data;
+  /**
+   * The option being previewed.  `selected` falls back to the first candidate
+   * when the traveller has not chosen anything yet, so it is a *preview* and
+   * must never be presented as the trip the traveller is on.
