-type LocaleState = {
-  locale: TripLocale;
-  setLocale: (l: TripLocale) => void;
-  t: (key: string, params?: Record<string, string | number>) => string;
-  switchLocale: () => void;
-};
-
-const LocaleContext = createContext<LocaleState | null>(null);
-
