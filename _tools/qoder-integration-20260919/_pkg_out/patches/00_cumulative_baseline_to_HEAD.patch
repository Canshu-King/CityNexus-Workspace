+++ b/frontend/e2e/_qoderContrastScan.ts
@@ -0,0 +1,223 @@
+import type { Page } from "@playwright/test";
+
+/**
+ * Shared dark-mode contrast scan for the Qoder frontend gates.
+ *
+ * Implements GPT's final dark gate table as a single source of truth used by
+ * both e2e/qoder-dark-audit.spec.ts (real Today/Live surfaces) and
+ * e2e/qoder-live-structure.spec.ts (the mocked L1/L2/L3 replan states), so the
+ * four tiers are judged identically everywhere:
+ *   FAIL — text AA (body <4.5, large <3), a required control boundary <3:1, a
+ *          state indicator <3:1 (colour-only), and ~white un-tokenised surfaces.
+ *   WARN — decorative borders (counted, never gating).
+ * Intent comes from data-contrast-role in the DOM, not from guessing CSS.
+ */
+
+export interface Violation {
+  kind: "text-contrast" | "light-surface" | "control-boundary" | "state-indicator";
+  selector: string;
+  testId: string | null;
+  text: string;
+  color: string;
+  background: string;
+  fontSizePx: number;
+  bold: boolean;
+  contrast: number;
+  required: number;
+}
+
+export interface ScanResult {
+  count: number;
+  rows: Violation[];
+  warnings: number;
+}
+
+export async function scanContrast(
+  page: Page,
+  opts: { scheme?: "dark" | "light" } = {},
+): Promise<ScanResult> {
+  // The "light-surface" tier means "an un-tokenised near-white block now
+  // floating on the dark theme". Under the light theme a white surface is
+  // correct, so that tier must not fire there — otherwise the light audit is
+  // mostly noise and the real text failures hide inside it.
+  const { scheme = "dark" } = opts;
+  return page.evaluate(({ scheme }) => {
+    type Row = Violation;
+    const parse = (value: string): [number, number, number, number] => {
+      const m = value.match(/rgba?\(([^)]+)\)/);
+      if (!m) return [0, 0, 0, value === "transparent" ? 0 : 1];
+      const p = m[1].split(",").map((x) => parseFloat(x.trim()));
+      return [p[0] || 0, p[1] || 0, p[2] || 0, p.length > 3 ? p[3] : 1];
+    };
+    const compositeOver = (
+      fg: [number, number, number, number],
+      bg: [number, number, number],
+    ): [number, number, number] => [
+      fg[0] * fg[3] + bg[0] * (1 - fg[3]),
+      fg[1] * fg[3] + bg[1] * (1 - fg[3]),
+      fg[2] * fg[3] + bg[2] * (1 - fg[3]),
+    ];
+    const channel = (c: number) => {
+      const s = c / 255;
+      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+    };
+    const lum = (rgb: [number, number, number]) =>
+      0.2126 * channel(rgb[0]) + 0.7152 * channel(rgb[1]) + 0.0722 * channel(rgb[2]);
+    const contrast = (a: [number, number, number], b: [number, number, number]) => {
+      const la = lum(a);
+      const lb = lum(b);
+      return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+    };
+    const backgroundUnder = (el: Element | null): [number, number, number] => {
+      const stack: Array<[number, number, number, number]> = [];
+      let cur: Element | null = el;
+      while (cur) {
+        const bg = parse(getComputedStyle(cur).backgroundColor);
+        if (bg[3] > 0) {
+          stack.push(bg);
+          if (bg[3] >= 0.999) break;
+        }
+        cur = cur.parentElement;
+      }
+      let acc: [number, number, number] = [0, 0, 0];
+      for (let i = stack.length - 1; i >= 0; i--) acc = compositeOver(stack[i], acc);
+      return acc;
+    };
+    const hasDirectText = (el: Element): string => {
+      let text = "";
+      el.childNodes.forEach((n) => {
+        if (n.nodeType === 3) text += n.textContent ?? "";
+      });
+      return text.trim();
+    };
+    const isVisible = (el: Element): boolean => {
+      const style = getComputedStyle(el);
+      if (style.display === "none" || style.visibility === "hidden") return false;
+      if (parseFloat(style.opacity) < 0.03) return false;
+      const rect = el.getBoundingClientRect();
+      if (rect.width < 2 || rect.height < 2) return false;
+      if (rect.bottom < 0 || rect.top > innerHeight || rect.right < 0 || rect.left > innerWidth)
+        return false;
+      return true;
+    };
+    const describe = (el: Element): string => {
+      const tid = el.getAttribute("data-testid");
+      if (tid) return `[data-testid="${tid}"]`;
+      const cls = (el.getAttribute("class") || "").split(/\s+/).filter(Boolean).slice(0, 3).join(".");
+      return `${el.tagName.toLowerCase()}${cls ? "." + cls : ""}`;
+    };
+
+    const rows: Row[] = [];
+    const all = Array.from(document.querySelectorAll<HTMLElement>("body *"));
+    const bw = (st: CSSStyleDeclaration) => parseFloat(st.borderTopWidth) || 0;
+
+    for (const el of all) {
+      if (!isVisible(el)) continue;
+      const style = getComputedStyle(el);
+      const bg = backgroundUnder(el);
+      const selfBg = parse(style.backgroundColor);
+
+      if (scheme === "dark" && selfBg[3] > 0.6 && lum(bg) > 0.82) {
+        rows.push({
+          kind: "light-surface",
+          selector: describe(el),
+          testId: el.getAttribute("data-testid"),
+          text: (el.getAttribute("class") || "").slice(0, 60),
+          color: style.color,
+          background: style.backgroundColor,
+          fontSizePx: parseFloat(style.fontSize),
+          bold: parseInt(style.fontWeight || "400", 10) >= 600,
+          contrast: 0,
+          required: 0,
+        });
+      }
+
+      const text = hasDirectText(el);
+      if (text) {
+        const color = parse(style.color);
+        if (color[3] >= 0.05) {
+          const ratio = contrast(compositeOver(color, bg), bg);
+          const sizePx = parseFloat(style.fontSize);
+          const weight = parseInt(style.fontWeight || "400", 10);
+          const required = sizePx >= 24 || (sizePx >= 18.66 && weight >= 700) ? 3.0 : 4.5;
+          if (ratio < required) {
+            rows.push({
+              kind: "text-contrast",
+              selector: describe(el),
+              testId: el.getAttribute("data-testid"),
+              text: text.slice(0, 60),
+              color: style.color,
+              background: style.backgroundColor,
+              fontSizePx: sizePx,
+              bold: weight >= 600,
+              contrast: Math.round(ratio * 100) / 100,
+              required,
+            });
+          }
+        }
+      }
+    }
+
+    let warnings = 0;
+    for (const el of all) {
+      if (!isVisible(el)) continue;
+      const style = getComputedStyle(el);
+      const bg = backgroundUnder(el);
+      const role = el.getAttribute("data-contrast-role");
+      const isControl = role === "control" || el.classList.contains("v8-outline-button");
+      const isState = role === "state";
+      const parentBg = el.parentElement ? backgroundUnder(el.parentElement) : bg;
+
+      if (isControl) {
+        const fill = parse(style.backgroundColor);
+        const fillC = fill[3] > 0.5 ? contrast(compositeOver(fill, parentBg), parentBg) : 0;
+        const bc = parse(style.borderTopColor);
+        const borderC = bw(style) >= 1 && bc[3] > 0.3 ? contrast(compositeOver(bc, parentBg), parentBg) : 0;
+        if (fillC < 3 && borderC < 3) {
+          rows.push({
+            kind: "control-boundary",
+            selector: describe(el),
+            testId: el.getAttribute("data-testid"),
+            text: (hasDirectText(el) || el.getAttribute("class") || "").slice(0, 40),
+            color: style.borderTopColor,
+            background: style.backgroundColor,
+            fontSizePx: parseFloat(style.fontSize),
+            bold: false,
+            contrast: Math.round(Math.max(fillC, borderC) * 100) / 100,
+            required: 3,
+          });
+        }
+        continue;
+      }
+      if (isState) {
+        const fill = parse(style.backgroundColor);
+        const fillC = fill[3] > 0.5 ? contrast(compositeOver(fill, parentBg), parentBg) : 0;
+        const color = parse(style.color);
+        const colorC = color[3] > 0.05 ? contrast(compositeOver(color, bg), bg) : 0;
+        const label = el.querySelector<HTMLElement>("span") ?? el;
+        const weight = parseInt(getComputedStyle(label).fontWeight || "400", 10);
+        const before = getComputedStyle(el, "::before").content;
+        const hasBar = !!before && before !== "none" && before !== "normal";
+        const pass = fillC >= 3 || colorC >= 3 || (weight >= 600 && colorC >= 1.5) || (fillC >= 1.3 && (weight >= 600 || hasBar));
+        if (!pass) {
+          rows.push({
+            kind: "state-indicator",
+            selector: describe(el),
+            testId: el.getAttribute("data-testid"),
+            text: (hasDirectText(el) || el.getAttribute("class") || "").slice(0, 40),
+            color: style.color,
+            background: style.backgroundColor,
+            fontSizePx: parseFloat(style.fontSize),
+            bold: weight >= 600,
+            contrast: Math.round(Math.max(fillC, colorC) * 100) / 100,
+            required: 3,
+          });
+        }
+        continue;
+      }
+      if (bw(style) >= 1 && parse(style.borderTopColor)[3] > 0.2) warnings += 1;
+    }
+
+    return { count: all.length, rows, warnings };
+  }, { scheme });
+}
diff --git a/frontend/e2e/_qoderRealSeed.setup.ts b/frontend/e2e/_qoderRealSeed.setup.ts
new file mode 100644
index 0000000..5ecc886
--- /dev/null
+++ b/frontend/e2e/_qoderRealSeed.setup.ts
@@ -0,0 +1,148 @@
+import { expect, test as setup } from "@playwright/test";
+import { existsSync, mkdirSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+/**
+ * Real-seed global setup (integration environment, 2026-09-19).
+ *
+ * The legacy V8/V10/V13 product specs do not create their own journey: they
+ * navigate straight to `/v8`, `/v8/live` or `/v8/inbox` and assert against a
+ * journey the *product* has already established. Without that seed each of them
+ * dies on its very first "is the journey there?" assertion, which is how a
+ * missing environment gets mis-read as either a regression or an unsolvable
+ * limit.
+ *
+ * This setup establishes that journey through the product's own surfaces, in the
+ * order a user would:
+ *
+ *   1. POST /api/v1/demo/reset                       -> traveller + journey
+ *   2. POST /inbox/import + /inbox/{id}/confirm x3   -> real reservations
+ *                                                      (arrival / mid-trip / departure)
+ *   3. /v8/discover -> "discover" button             -> sealed real-city replay,
+ *                                                      FULLY GROUNDED plan, located
+ *                                                      activities, legs, one SELECTED
+ *                                                      active plan version
+ *   4. localStorage["citynexus.v8.journey_id"]       -> persisted as a storageState
+ *
+ * No SQL writes, no monkey-patched modules, no `route.fulfill` mocks. If a spec
+ * still fails after this seed, it failed on a business assertion — which is the
+ * classification the arbiter asked for instead of another argument about the
+ * isolated environment.
+ */
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const BASE =
+  process.env.CITYNEXUS_E2E_BASE_URL ??
+  `http://127.0.0.1:${Number(process.env.CITYNEXUS_E2E_PORT ?? 4173)}`;
+const STATE = path.join(HERE, ".qoder-seed-state.json");
+
+type AnchorRole = "ARRIVAL" | "MID_TRIP" | "DEPARTURE";
+
+/** Same three reservations the passing v13-5 spec imports — the demo city has a
+ *  sealed real-city replay for exactly this shape (place-river-cruise etc). */
+function reservation(role: AnchorRole): Record<string, unknown> {
+  if (role === "ARRIVAL") {
+    return {
+      reservation_type: "RAIL",
+      provider_key: "qoder-real-seed",
+      confirmation_ref: "SEED-ARRIVAL",
+      origin: { name: "Beijing South", city: "Beijing" },
+      destination: { name: "Tianjin West Station", city: "Tianjin", latitude: 39.112, longitude: 117.198 },
+      scheduled_departure_at: "2026-10-10T07:55:00+08:00",
+      scheduled_arrival_at: "2026-10-10T09:00:00+08:00",
+      price_amount_minor: 5500,
+      currency: "CNY",
+      price_status: "KNOWN",
+      anchor_role: role,
+    };
+  }
+  if (role === "DEPARTURE") {
+    return {
+      reservation_type: "RAIL",
+      provider_key: "qoder-real-seed",
+      confirmation_ref: "SEED-DEPARTURE",
+      origin: { name: "Tianjin West Station", city: "Tianjin", latitude: 39.112, longitude: 117.198 },
+      destination: { name: "Beijing South", city: "Beijing" },
+      scheduled_departure_at: "2026-10-10T18:30:00+08:00",
+      scheduled_arrival_at: "2026-10-10T19:00:00+08:00",
+      price_amount_minor: 5500,
+      currency: "CNY",
+      price_status: "KNOWN",
+      anchor_role: role,
+    };
+  }
+  return {
+    reservation_type: "FERRY",
+    provider_key: "qoder-real-seed",
+    confirmation_ref: "SEED-CRUISE",
+    origin: { name: "Haihe Wharf", city: "Tianjin" },
+    destination: { name: "Haihe Cruise", city: "Tianjin" },
+    scheduled_departure_at: "2026-10-10T15:30:00+08:00",
+    scheduled_arrival_at: "2026-10-10T16:30:00+08:00",
+    price_amount_minor: 12000,
+    currency: "CNY",
+    price_status: "KNOWN",
+    anchor_role: role,
+    semantic_node_key: "place-river-cruise",
+  };
+}
+
+setup("seed a real journey through the product API", async ({ browser }) => {
+  const context = await browser.newContext({ viewport: { width: 412, height: 915 } });
+  const page = await context.newPage();
+
+    const reset = await page.request.post(`${BASE}/api/v1/demo/reset`);
+    if (!reset.ok()) throw new Error(`real-seed setup: demo/reset -> HTTP ${reset.status()}`);
+    const journeyId: string = (await reset.json()).journey_id;
+    if (!journeyId) throw new Error("real-seed setup: demo/reset returned no journey_id");
+
+    for (const role of ["ARRIVAL", "MID_TRIP", "DEPARTURE"] as AnchorRole[]) {
+      const imported = await page.request.post(`${BASE}/api/v1/journeys/${journeyId}/inbox/import`, {
+        data: { artifact_type: "STRUCTURED_JSON", payload: { reservation: reservation(role) } },
+      });
+      if (!imported.ok()) {
+        throw new Error(`real-seed setup: inbox/import ${role} -> HTTP ${imported.status()}`);
+      }
+      const draftId = (await imported.json()).id;
+      const confirmed = await page.request.post(
+        `${BASE}/api/v1/journeys/${journeyId}/inbox/${draftId}/confirm`,
+      );
+      if (!confirmed.ok()) {
+        throw new Error(`real-seed setup: confirm ${role} -> HTTP ${confirmed.status()}`);
+      }
+    }
+
+    await page.addInitScript((id) => {
+      localStorage.setItem("citynexus.v8.journey_id", id);
+      localStorage.setItem("citynexus.demo.journey_id", id);
+    }, journeyId);
+
+    // Materialise the active plan the way the product does: real-city discovery
+    // on the sealed replay, then the plan the panel selects.
+    await page.goto(`${BASE}/v8/discover`, { waitUntil: "load" });
+    await page.waitForTimeout(2500);
+    const submit = page.getByTestId("v13-discover-submit");
+    if (await submit.isVisible().catch(() => false)) {
+      await submit.click();
+      await page
+        .waitForSelector('[data-testid="v13-discovery-selected-plan"]', { timeout: 90_000 })
+        .catch(() => undefined);
+    }
+    const selected = await page
+      .getByTestId("v13-discovery-selected-plan")
+      .textContent()
+      .catch(() => null);
+    console.log(
+      `[qoder-real-seed] journey=${journeyId} selectedPlan=${selected ? selected.trim().slice(0, 60) : "NONE"}`,
+    );
+
+    await page.goto(`${BASE}/v8/live`, { waitUntil: "load" });
+    await page.waitForTimeout(3000);
+    const stillWizard = await page.getByTestId("trial-setup").isVisible().catch(() => false);
+    if (stillWizard) console.log("[qoder-real-seed] WARN /v8/live still shows the trial wizard");
+
+    if (!existsSync(HERE)) mkdirSync(HERE, { recursive: true });
+    await context.storageState({ path: STATE });
+    expect(existsSync(STATE)).toBe(true);
+  },
+);
diff --git a/frontend/e2e/_qoderShellSeed.ts b/frontend/e2e/_qoderShellSeed.ts
new file mode 100644
index 0000000..a230556
--- /dev/null
+++ b/frontend/e2e/_qoderShellSeed.ts
@@ -0,0 +1,38 @@
+import { expect, type Page } from "@playwright/test";
+
+/**
+ * Seed a real, fully-populated journey the way the product itself does, so the
+ * Today (/v8/hub) and Live (/v8/live) surfaces render against genuine backend
+ * API responses. The setup screen's "Tianjin demo" button creates the traveler
+ * + journey and generates stay options, persisting `citynexus.v8.journey_id`.
+ *
+ * Shared by the Qoder frontend gates (dark-mode audit, mobile overflow) so they
+ * audit the same reachable surfaces without a fragile per-spec fixture.
+ * Idempotent: if a journey is already loaded it returns immediately.
+ */
+export async function ensureDemoJourney(page: Page): Promise<void> {
+  await page.goto("/v8", { waitUntil: "load" });
+  await page.waitForTimeout(600);
+  const setup = page.getByTestId("trial-setup");
+  if (await setup.isVisible().catch(() => false)) {
+    await page.getByTestId("trial-tianjin-demo").click();
+    await page
+      .waitForFunction(() => !!localStorage.getItem("citynexus.v8.journey_id"), null, {
+        timeout: 30_000,
+      });
+    await page.waitForTimeout(1000);
+  }
+}
+
+/** Land on a route inside the V8 shell and wait for its anchor surface. */
+export async function openScreen(
+  page: Page,
+  url: string,
+  readyTestIds: string[],
+): Promise<void> {
+  await page.goto(url, { waitUntil: "load" });
+  for (const id of readyTestIds) {
+    await expect(page.getByTestId(id).first()).toBeVisible({ timeout: 25_000 });
+  }
+  await page.waitForTimeout(1200);
+}
diff --git a/frontend/e2e/qoder-ack-rendered.spec.ts b/frontend/e2e/qoder-ack-rendered.spec.ts
new file mode 100644
index 0000000..abc33e1
--- /dev/null
+++ b/frontend/e2e/qoder-ack-rendered.spec.ts
@@ -0,0 +1,334 @@
+/**
+ * T3 — acknowledgement vs resolution (docs/ACK_RESOLUTION_CONTRACT.md).
+ * LAYER: integration (RENDERED component), not unit.
+ *
+ * Unlike e2e/qoder-ack-resolution.spec.ts (which drives the pure predicate via
+ * `page.evaluate(import .../disruptionState.ts)` and is labelled unit), this
+ * spec renders the real React surface: it serves deterministic fixtures through
+ * `page.route` for every API the application actually fetches, boots the real
+ * V8Experience shell on the real `/v8/live` route, and lets the real
+ * `LiveRecovery` component (`src/features/execution/LiveRecovery.tsx`) paint.
+ * The assertions are on rendered DOM (`getByTestId` / `getByText`), never on an
+ * imported function's return value.
+ *
+ * What this pins (the V2-T3 fix — the old `acknowledgedOnly > 0 && openDisruptions
+ * === 0` guard made the "已知晓，仍待处理" notice unreachable, because an
+ * acknowledged-only event is by construction a subset of the open set):
+ *   1. An ACKNOWLEDGED disruption with NO linked ACCEPTED replan stays open, so
+ *      BOTH "发生了什么" (live-disruption) AND "已知晓，仍待处理"
+ *      (live-acknowledged) render at the same time.
+ *   2. An ACCEPTED proposal whose trigger_event_id matches the event closes it:
+ *      neither the open notice nor the acknowledged notice is shown; the event
+ *      surfaces as handled instead.
+ *   3. An ACCEPTED proposal with an UNRELATED trigger_event_id does NOT close the
+ *      event; it stays open (both notices still render).
+ *
+ * Endpoints mocked (the exact URLs LiveRecovery + its V8Experience shell fetch):
+ *   /api/v1/journeys/{id}/experience      (shell `load()` + LiveRecovery disruption
+ *                                          merge of active_plan.disruptions)
+ *   /api/v1/journeys/{id}/replans         (LiveRecovery proposals -> acceptedTriggerIds)
+ *   /api/v1/journeys/{id}/plans           (authoritative plans via useAuthoritativePlans)
+ *   /api/v1/journeys/{id}/twin            (authoritative twin via useAuthoritativeTwin)
+ *   /api/v1/travelers/{id}/agent-policy   (shell boot)
+ *   /api/v1/journeys/{id}/wallet          (shell boot)
+ *   /api/v1/journeys/{id}/offline-snapshot(shell boot; written to Dexie, needs journey_id)
+ *   /api/v1/agent/runtime-status          (shell boot)
+ *   everything else under /api/v1/        (sibling Live / V10 panels) -> {} neutral state
+ */
+
+import { expect, test, type Page } from "@playwright/test";
+
+const JOURNEY_ID = "e2e-render-journey";
+const TRAVELER_ID = "e2e-render-traveler";
+
+/**
+ * Boot the real app in a deterministic, isolated way:
+ *  - seed the journey id the shell reads from localStorage on boot, and force
+ *    the zh-CN locale so the live copy ("发生了什么" / "已知晓，仍待处理") is the
+ *    literal string the review asked to see on screen;
+ *  - neuter the PWA service worker registration so it can never serve a cached
+ *    shell and our route fixtures stay authoritative.
+ */
+async function seed(page: Page) {
+  await page.addInitScript(() => {
+    localStorage.setItem("citynexus.v8.journey_id", "e2e-render-journey");
+    localStorage.setItem("citynexus.locale", "zh-CN");
+    // Prevent the dev service worker from registering / claiming clients.
+    try {
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      (navigator as any).serviceWorker.register = () => Promise.resolve({});
+    } catch {
+      /* no-op */
+    }
+  });
+}
+
+type Disruption = {
+  id: string;
+  type: string;
+  severity: string;
+  status?: string | null;
+  affected_activity_id: string | null;
+  occurred_at: string;
+  resolved_at?: string | null;
+};
+
+type Proposal = {
+  id: string;
+  status: string;
+  trigger_event_id?: string | null;
+  hard_constraints_passed: boolean;
+  locked_commitments_preserved: boolean;
+  diff: { removed?: string[]; added?: string[]; moved?: string[] };
+};
+
+function experienceFixture(disruptions: Disruption[]) {
+  return {
+    journey: {
+      id: JOURNEY_ID,
+      traveler_id: TRAVELER_ID,
+      title: "厦门周末",
+      city_code: "CN-XIAMEN",
+      timezone: "Asia/Shanghai",
+      start_at: "2026-10-09T18:00:00+08:00",
+      end_at: "2026-10-11T15:00:00+08:00",
+      budget: { amount_minor: 120000, currency: "CNY" },
+    },
+    trip: {
+      arrival_anchor: { at: "2026-10-09T18:00:00+08:00", location: "厦门站" },
+      departure_anchor: { at: "2026-10-11T15:00:00+08:00", location: "厦门高崎机场" },
+      party_size: 2,
+      occupancy: { adults: 2, rooms: 1 },
+      stay_budget: { amount_minor: 70000, currency: "CNY" },
+    },
+    offers: [],
+    options: [],
+    selected_option_id: null,
+    mobility_facts: [],
+    active_plan: {
+      id: "plan-1",
+      version_no: 1,
+      status: "ACTIVE",
+      source: "E2E_RENDER",
+      current_activity_id: null,
+      // Deliberately no located activities / legs: keeps MapPanel in its honest
+      // empty state so maplibre never loads external tiles.
+      activities: [],
+      legs: [],
+      user_location: null,
+      disruptions,
+    },
+    recovery: null,
+    experience_flags: {
+      needs_review: false,
+      recovery_required: false,
+      staleness: false,
+      feasibility_failures: [],
+    },
+  };
+}
+
+function offlineFixture() {
+  return {
+    journey_id: JOURNEY_ID,
+    sequence: 1,
+    valid_until: "2026-12-31T00:00:00Z",
+    snapshot: {
+      active_plan_version_id: null,
+      current_activity_id: null,
+      next_24h: [],
+      legs: [],
+      hotel: null,
+      reservations: [],
+      read_only: true,
+      financial_actions_allowed: false,
+    },
+    provider_freshness: { latest_provider_capture_at: null, transit_realtime: "UNKNOWN" },
+    updated_at: "2026-10-09T10:00:00Z",
+  };
+}
+
+/** One dispatcher on /api/v1/ so route-registration order can never bite. */
+async function mockApi(page: Page, fx: { experience: unknown; replans: unknown }) {
+  await page.route(/\/api\/v1\//, (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    const send = (json: unknown) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify(json),
+      });
+    if (pathname.endsWith("/experience")) return send(fx.experience);
+    if (pathname.endsWith("/replans")) return send(fx.replans);
+    if (pathname.endsWith("/plans")) return send([]);
+    if (pathname.endsWith("/twin")) return send({ id: "twin-1", context: {} });
+    if (pathname.endsWith("/agent-policy"))
+      return send({
+        mode: "ADVISORY",
+        auto_accept_replan: false,
+        version: 1,
+        max_auto_replan_cost_delta_minor: 5000,
+        max_auto_loss_minor: 0,
+        max_auto_schedule_drift_min: 20,
+      });
+    if (pathname.endsWith("/wallet"))
+      return send({ reservations: [], commitments: [], offline_ready: true });
+    if (pathname.endsWith("/offline-snapshot")) return send(offlineFixture());
+    if (pathname.endsWith("/runtime-status")) return send({});
+    // The /v8/live route also mounts V10LiveExecutionPanel, which reads
+    // `web.data.observations.length` (not optional beyond web.data) and
+    // `new Date(clock.data.now)`, so these must be well-formed.
+    if (pathname.endsWith("/execution-clock"))
+      return send({ now: "2026-10-09T10:00:00+08:00", timezone: "Asia/Shanghai", current_activity_id: null });
+    if (pathname.endsWith("/web-observations")) return send({ observations: [] });
+    return send({});
+  });
+}
+
+const WEATHER_EVENT: Disruption = {
+  id: "evt-1",
+  type: "WEATHER",
+  severity: "MEDIUM",
+  status: "ACKNOWLEDGED",
+  affected_activity_id: null,
+  occurred_at: "2026-10-09T20:00:00+08:00",
+};
+
+test.describe("T3 acknowledgement vs resolution (rendered integration)", () => {
+  test("an ACKNOWLEDGED disruption with no linked acceptance stays open: both '发生了什么' and '已知晓，仍待处理' render", async ({
+    page,
+  }) => {
+    await seed(page);
+    // No ACCEPTED replan behind the event at all.
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [] });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    // The real LiveRecovery section mounted.
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+
+    // V2-T3 fix: the acknowledged-only notice is now reachable WHILE the event is
+    // still open — the two co-render (the old dead-condition could not).
+    const disruption = page.getByTestId("live-disruption");
+    await expect(disruption).toBeVisible();
+    await expect(disruption).toContainText("发生了什么");
+
+    const acknowledged = page.getByTestId("live-acknowledged");
+    await expect(acknowledged).toBeVisible();
+    await expect(acknowledged).toContainText("已知晓，仍待处理");
+
+    // The traveller has only seen it; nothing is handled yet.
+    await expect(page.getByTestId("live-handled")).toHaveCount(0);
+  });
+
+  test("an ACCEPTED proposal linked to the event by trigger_event_id closes it: no open/acknowledged notice, shown as handled", async ({
+    page,
+  }) => {
+    await seed(page);
+    const accepted: Proposal = {
+      id: "r1",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-1",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [accepted] });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+    // Exact linkage resolves the event -> it is no longer in the open set, so the
+    // "发生了什么" block and the "已知晓，仍待处理" notice both disappear.
+    await expect(page.getByTestId("live-disruption")).toHaveCount(0);
+    await expect(page.getByTestId("live-acknowledged")).toHaveCount(0);
+    await expect(page.getByTestId("live-handled")).toBeVisible();
+  });
+
+  test("an ACCEPTED proposal with an UNRELATED trigger_event_id leaves the event open", async ({
+    page,
+  }) => {
+    await seed(page);
+    const acceptedUnrelated: Proposal = {
+      id: "r2",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-999",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, {
+      experience: experienceFixture([WEATHER_EVENT]),
+      replans: [acceptedUnrelated],
+    });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+    // Accepting a proposal for a DIFFERENT event must not silently resolve this one.
+    await expect(page.getByTestId("live-disruption")).toBeVisible();
+    await expect(page.getByTestId("live-disruption")).toContainText("发生了什么");
+    await expect(page.getByTestId("live-acknowledged")).toBeVisible();
+    await expect(page.getByTestId("live-handled")).toHaveCount(0);
+  });
+});
+
+/**
+ * V3-5: the SAME rule must hold on the Today surface, not only Live.  The
+ * `today-attention` cell in V8Experience counts OPEN disruptions via the shared
+ * `isDisruptionOpen`, so an acknowledged-only event is a countable unresolved
+ * change there too, and a matching accepted replan drops it from the count.
+ */
+test.describe("T3 ack vs resolution — Today surface (rendered integration)", () => {
+  test("an ACKNOWLEDGED event with no acceptance stays an unresolved change on Today", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [] });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    await expect(attention).toContainText("1 项变化");
+  });
+
+  test("a matching ACCEPTED replan clears the change count on Today", async ({ page }) => {
+    await seed(page);
+    const accepted: Proposal = {
+      id: "r1",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-1",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [accepted] });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    // No longer an open/unresolved change once the linked recovery is accepted.
+    await expect(attention).not.toContainText("1 项变化");
+  });
+
+  test("an UNRELATED accepted proposal still leaves the change unresolved on Today", async ({
+    page,
+  }) => {
+    await seed(page);
+    const acceptedUnrelated: Proposal = {
+      id: "r2",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-999",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, {
+      experience: experienceFixture([WEATHER_EVENT]),
+      replans: [acceptedUnrelated],
+    });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    // Accepting a proposal for a DIFFERENT event must not clear this one on Today.
+    await expect(attention).toContainText("1 项变化");
+  });
+});
