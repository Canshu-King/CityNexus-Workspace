diff --git a/frontend/e2e/_qoderAuthoritativeSetup.ts b/frontend/e2e/_qoderAuthoritativeSetup.ts
new file mode 100644
index 0000000..c9ee58d
--- /dev/null
+++ b/frontend/e2e/_qoderAuthoritativeSetup.ts
@@ -0,0 +1,71 @@
+import { request } from "@playwright/test";
+
+/* Runs after Playwright has started both webServers, which is what makes an
+   ownership assertion possible here at all — a port-free check would only ever
+   see this run's own processes.
+
+   The pass-13 provenance gate asks one question of the server it is about to
+   test against: did *this* invocation start you?  The suite passes a per-run
+   token into the backend it spawns; only that process can echo it back through
+   /health, and because the request goes to the frontend origin, a matching
+   answer also proves the dev server we are driving proxies to it.  A borrowed
+   :8000 from another agent lane returns an empty token and the run stops. */
+
+function refuse(reason: string): never {
+  throw new Error(`[citynexus e2e] authoritative provenance check failed: ${reason}`);
+}
+
+export default async function authoritativeProvenanceCheck() {
+  if (process.env.CITYNEXUS_E2E_AUTHORITATIVE !== "1") return;
+
+  const runId = process.env.CITYNEXUS_E2E_RUN_ID;
+  const frontendPort = process.env.CITYNEXUS_E2E_PORT;
+  const backendPort = process.env.CITYNEXUS_BACKEND_PORT;
+  const databaseUrl = process.env.CITYNEXUS_DATABASE_URL ?? "";
+  if (!runId) refuse("CITYNEXUS_E2E_RUN_ID is required in authoritative mode");
+
+  /* Freshness is enforced in the process that opens the database —
+     backend/app/db/session.py refuses to reopen an existing file for a
+     run-stamped process.  It cannot be checked here or in the config: by the time
+     this hook runs, the backend this invocation started has already created the
+     file.  What is verified below is which file that process opened, by basename,
+     because /health deliberately does not expose a connection URI. */
+  const expectedDatabaseId = databaseUrl.replace(/^sqlite:\/\/\//, "").split(/[\\/]/).pop();
+
+  const api = await request.newContext({ baseURL: `http://127.0.0.1:${frontendPort}` });
+  let health: Record<string, string>;
+  try {
+    const response = await api.get("/api/v1/health");
+    if (!response.ok()) refuse(`/health answered ${response.status()} via :${frontendPort}`);
+    health = await response.json();
+  } catch (error) {
+    refuse(
+      `could not read /health through the frontend on :${frontendPort} (${error}). ` +
+        `The suite may not be talking to the servers this run started.`,
+    );
+  } finally {
+    await api.dispose();
+  }
+
+  if (health.e2e_run_id !== runId) {
+    refuse(
+      `the backend answering :${backendPort} reports e2e_run_id="${health.e2e_run_id ?? ""}" ` +
+        `but this run issued "${runId}". That server was started by someone else — ` +
+        `find it with "netstat -ano | grep ':${backendPort} .*LISTENING'".`,
+    );
+  }
+  if (health.ai !== "disabled") {
+    refuse(`external AI must be disabled for the authoritative suite, /health says "${health.ai}"`);
+  }
+  if (health.e2e_database_id !== expectedDatabaseId) {
+    refuse(
+      `this run asked for database "${expectedDatabaseId}" but the backend opened ` +
+        `"${health.e2e_database_id ?? ""}" — the database is not the one this invocation created.`,
+    );
+  }
+
+  console.error(
+    `[citynexus e2e] provenance ok: run=${runId} frontend=:${frontendPort} -> ` +
+      `backend=:${backendPort} ai=disabled db=${health.e2e_database_id}`,
+  );
+}
diff --git a/frontend/e2e/_qoderContrastScan.ts b/frontend/e2e/_qoderContrastScan.ts
new file mode 100644
index 0000000..7233daf
--- /dev/null
+++ b/frontend/e2e/_qoderContrastScan.ts
@@ -0,0 +1,223 @@
+import type { Page } from "@playwright/test";
+
+/**
+ * Shared dark-mode contrast scan for the Qoder frontend gates.
+ *
+ * Implements GPT's final dark gate table as a single source of truth used by
+ * both e2e/qoder-contrast-audit.spec.ts (real Today/Live surfaces) and
+ * e2e/qoder-live-structure.spec.ts (the mocked L1/L2/L3 replan states), so the
+ * four tiers are judged identically everywhere:
+ *   FAIL — text AA (body <4.5, large <3), a required control boundary <3:1, a
+ *          state indicator <3:1 (colour-only), and ~white un-tokenised surfaces.
+ *   WARN — decorative borders (counted, never gating).
+ * Intent comes from data-contrast-role in the DOM, not from guessing CSS.
+ */
+
+export interface Violation {
+  kind: "text-contrast" | "light-surface" | "control-boundary" | "state-indicator";
+  selector: string;
+  testId: string | null;
+  text: string;
+  color: string;
+  background: string;
+  fontSizePx: number;
+  bold: boolean;
+  contrast: number;
+  required: number;
+}
+
+export interface ScanResult {
+  count: number;
+  rows: Violation[];
+  warnings: number;
+}
+
+export async function scanContrast(
+  page: Page,
+  opts: { scheme?: "dark" | "light" } = {},
+): Promise<ScanResult> {
+  // The "light-surface" tier means "an un-tokenised near-white block now
+  // floating on the dark theme". Under the light theme a white surface is
+  // correct, so that tier must not fire there — otherwise the light audit is
+  // mostly noise and the real text failures hide inside it.
+  const { scheme = "dark" } = opts;
+  return page.evaluate(({ scheme }) => {
+    type Row = Violation;
+    const parse = (value: string): [number, number, number, number] => {
+      const m = value.match(/rgba?\(([^)]+)\)/);
+      if (!m) return [0, 0, 0, value === "transparent" ? 0 : 1];
+      const p = m[1].split(",").map((x) => parseFloat(x.trim()));
+      return [p[0] || 0, p[1] || 0, p[2] || 0, p.length > 3 ? p[3] : 1];
+    };
+    const compositeOver = (
+      fg: [number, number, number, number],
+      bg: [number, number, number],
+    ): [number, number, number] => [
+      fg[0] * fg[3] + bg[0] * (1 - fg[3]),
+      fg[1] * fg[3] + bg[1] * (1 - fg[3]),
+      fg[2] * fg[3] + bg[2] * (1 - fg[3]),
+    ];
+    const channel = (c: number) => {
+      const s = c / 255;
+      return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+    };
+    const lum = (rgb: [number, number, number]) =>
+      0.2126 * channel(rgb[0]) + 0.7152 * channel(rgb[1]) + 0.0722 * channel(rgb[2]);
+    const contrast = (a: [number, number, number], b: [number, number, number]) => {
+      const la = lum(a);
+      const lb = lum(b);
+      return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+    };
+    const backgroundUnder = (el: Element | null): [number, number, number] => {
+      const stack: Array<[number, number, number, number]> = [];
+      let cur: Element | null = el;
+      while (cur) {
+        const bg = parse(getComputedStyle(cur).backgroundColor);
+        if (bg[3] > 0) {
+          stack.push(bg);
+          if (bg[3] >= 0.999) break;
+        }
+        cur = cur.parentElement;
+      }
+      let acc: [number, number, number] = [0, 0, 0];
+      for (let i = stack.length - 1; i >= 0; i--) acc = compositeOver(stack[i], acc);
+      return acc;
+    };
+    const hasDirectText = (el: Element): string => {
+      let text = "";
+      el.childNodes.forEach((n) => {
+        if (n.nodeType === 3) text += n.textContent ?? "";
+      });
+      return text.trim();
+    };
+    const isVisible = (el: Element): boolean => {
+      const style = getComputedStyle(el);
+      if (style.display === "none" || style.visibility === "hidden") return false;
+      if (parseFloat(style.opacity) < 0.03) return false;
+      const rect = el.getBoundingClientRect();
+      if (rect.width < 2 || rect.height < 2) return false;
+      if (rect.bottom < 0 || rect.top > innerHeight || rect.right < 0 || rect.left > innerWidth)
+        return false;
+      return true;
+    };
+    const describe = (el: Element): string => {
+      const tid = el.getAttribute("data-testid");
+      if (tid) return `[data-testid="${tid}"]`;
+      const cls = (el.getAttribute("class") || "").split(/\s+/).filter(Boolean).slice(0, 3).join(".");
+      return `${el.tagName.toLowerCase()}${cls ? "." + cls : ""}`;
+    };
+
+    const rows: Row[] = [];
+    const all = Array.from(document.querySelectorAll<HTMLElement>("body *"));
+    const bw = (st: CSSStyleDeclaration) => parseFloat(st.borderTopWidth) || 0;
+
+    for (const el of all) {
+      if (!isVisible(el)) continue;
+      const style = getComputedStyle(el);
+      const bg = backgroundUnder(el);
+      const selfBg = parse(style.backgroundColor);
+
+      if (scheme === "dark" && selfBg[3] > 0.6 && lum(bg) > 0.82) {
+        rows.push({
+          kind: "light-surface",
+          selector: describe(el),
+          testId: el.getAttribute("data-testid"),
+          text: (el.getAttribute("class") || "").slice(0, 60),
+          color: style.color,
+          background: style.backgroundColor,
+          fontSizePx: parseFloat(style.fontSize),
+          bold: parseInt(style.fontWeight || "400", 10) >= 600,
+          contrast: 0,
+          required: 0,
+        });
+      }
+
+      const text = hasDirectText(el);
+      if (text) {
+        const color = parse(style.color);
+        if (color[3] >= 0.05) {
+          const ratio = contrast(compositeOver(color, bg), bg);
+          const sizePx = parseFloat(style.fontSize);
+          const weight = parseInt(style.fontWeight || "400", 10);
+          const required = sizePx >= 24 || (sizePx >= 18.66 && weight >= 700) ? 3.0 : 4.5;
+          if (ratio < required) {
+            rows.push({
+              kind: "text-contrast",
+              selector: describe(el),
+              testId: el.getAttribute("data-testid"),
+              text: text.slice(0, 60),
+              color: style.color,
+              background: style.backgroundColor,
+              fontSizePx: sizePx,
+              bold: weight >= 600,
+              contrast: Math.round(ratio * 100) / 100,
+              required,
+            });
+          }
+        }
+      }
+    }
+
+    let warnings = 0;
+    for (const el of all) {
+      if (!isVisible(el)) continue;
+      const style = getComputedStyle(el);
+      const bg = backgroundUnder(el);
+      const role = el.getAttribute("data-contrast-role");
+      const isControl = role === "control" || el.classList.contains("v8-outline-button");
+      const isState = role === "state";
+      const parentBg = el.parentElement ? backgroundUnder(el.parentElement) : bg;
+
+      if (isControl) {
+        const fill = parse(style.backgroundColor);
+        const fillC = fill[3] > 0.5 ? contrast(compositeOver(fill, parentBg), parentBg) : 0;
+        const bc = parse(style.borderTopColor);
+        const borderC = bw(style) >= 1 && bc[3] > 0.3 ? contrast(compositeOver(bc, parentBg), parentBg) : 0;
+        if (fillC < 3 && borderC < 3) {
+          rows.push({
+            kind: "control-boundary",
+            selector: describe(el),
+            testId: el.getAttribute("data-testid"),
+            text: (hasDirectText(el) || el.getAttribute("class") || "").slice(0, 40),
+            color: style.borderTopColor,
+            background: style.backgroundColor,
+            fontSizePx: parseFloat(style.fontSize),
+            bold: false,
+            contrast: Math.round(Math.max(fillC, borderC) * 100) / 100,
+            required: 3,
+          });
+        }
+        continue;
+      }
+      if (isState) {
+        const fill = parse(style.backgroundColor);
+        const fillC = fill[3] > 0.5 ? contrast(compositeOver(fill, parentBg), parentBg) : 0;
+        const color = parse(style.color);
+        const colorC = color[3] > 0.05 ? contrast(compositeOver(color, bg), bg) : 0;
+        const label = el.querySelector<HTMLElement>("span") ?? el;
+        const weight = parseInt(getComputedStyle(label).fontWeight || "400", 10);
+        const before = getComputedStyle(el, "::before").content;
+        const hasBar = !!before && before !== "none" && before !== "normal";
+        const pass = fillC >= 3 || colorC >= 3 || (weight >= 600 && colorC >= 1.5) || (fillC >= 1.3 && (weight >= 600 || hasBar));
+        if (!pass) {
+          rows.push({
+            kind: "state-indicator",
+            selector: describe(el),
+            testId: el.getAttribute("data-testid"),
+            text: (hasDirectText(el) || el.getAttribute("class") || "").slice(0, 40),
+            color: style.color,
+            background: style.backgroundColor,
+            fontSizePx: parseFloat(style.fontSize),
+            bold: weight >= 600,
+            contrast: Math.round(Math.max(fillC, colorC) * 100) / 100,
+            required: 3,
+          });
+        }
+        continue;
+      }
+      if (bw(style) >= 1 && parse(style.borderTopColor)[3] > 0.2) warnings += 1;
+    }
+
+    return { count: all.length, rows, warnings };
+  }, { scheme });
+}
diff --git a/frontend/e2e/_qoderFreshJourney.ts b/frontend/e2e/_qoderFreshJourney.ts
new file mode 100644
index 0000000..589dd47
--- /dev/null
+++ b/frontend/e2e/_qoderFreshJourney.ts
@@ -0,0 +1,162 @@
+import { type APIRequestContext } from "@playwright/test";
+
+/**
+ * Per-spec journey isolation (pass-9 TEST_INFRA_ISOLATION_BLOCKER).
+ *
+ * The suite shares one backend and one SQLite file. A global seed can therefore
+ * only ever be a *default*: any spec that resets the demo, selects a different
+ * option, or accepts a proposal changes what the next spec sees, which is why
+ * three v10 specs pass in nine seconds alone and fail inside the serial run.
+ * Reordering or retrying would just be Playwright feng shui.
+ *
+ * The fix is ownership: a spec that depends on journey state creates its own and
+ * carries its own id, exactly as `v13-5-fully-grounded` and
+ * `real-world-trip-operations-v9` already do. This helper is that pattern in one
+ * place, built only from public product endpoints — no SQL, no mocked routes.
+ */
+export type FreshJourney = { journeyId: string; optionCount: number; optionId: string | null };
+
+const API =
+  process.env.CITYNEXUS_API_BASE_URL ??
+  `http://127.0.0.1:${Number(process.env.CITYNEXUS_BACKEND_PORT ?? 8000)}`;
+
+async function post<T = any>(
+  request: APIRequestContext,
+  url: string,
+  data?: unknown,
+  headers?: Record<string, string>,
+): Promise<T> {
+  const res = await request.post(`${API}${url}`, { data, headers });
+  if (!res.ok()) {
+    throw new Error(`${url} -> HTTP ${res.status()}: ${(await res.text()).slice(0, 180)}`);
+  }
+  return res.json();
+}
+
+async function get<T = any>(request: APIRequestContext, url: string): Promise<T> {
+  const res = await request.get(`${API}${url}`);
+  if (!res.ok()) throw new Error(`${url} -> HTTP ${res.status()}`);
+  return res.json();
+}
+
+/**
+ * Two nights in Tianjin, because a one-day trip makes the stay-aware optimiser
+ * return zero options and silently turns every downstream assertion into a test
+ * of an empty screen.
+ */
+export async function createFreshJourney(
+  request: APIRequestContext,
+  opts: { select?: boolean } = {},
+): Promise<FreshJourney> {
+  const traveler = await post(request, "/api/v1/travelers", {
+    display_name: "Qoder per-spec traveller",
+    locale: "en-GB",
+    timezone: "Asia/Shanghai",
+  });
+  const journey = await post(request, "/api/v1/journeys", {
+    traveler_id: traveler.id,
+    title: "Tianjin · per-spec weekend",
+    city_code: "CN-TIANJIN",
+    timezone: "Asia/Shanghai",
+    start_at: "2026-10-09T18:00:00+08:00",
+    end_at: "2026-10-11T15:00:00+08:00",
+    budget: { amount_minor: 120000, currency: "CNY" },
+  });
+
+  let optionCount = 0;
+  let optionId: string | null = null;
+  if (opts.select !== false) {
+    await post(request, `/api/v1/journeys/${journey.id}/stay-options/generate`);
+    const listed = await get(request, `/api/v1/journeys/${journey.id}/stay-options`);
+    const options = listed.options ?? [];
+    optionCount = options.length;
+    if (optionCount) {
+      const chosen = options.find((o: any) => o.status === "RECOMMENDED") ?? options[0];
+      optionId = chosen.id;
+      await post(request, `/api/v1/journeys/${journey.id}/stay-options/${chosen.id}/select`);
+    }
+  }
+
+  return { journeyId: journey.id, optionCount, optionId };
+}
+
+/** Carry a spec's own journey into the browser, overriding any shared seed. */
+export async function useJourney(page: import("@playwright/test").Page, journeyId: string) {
+  await page.addInitScript((id) => {
+    localStorage.setItem("citynexus.v8.journey_id", id);
+    localStorage.setItem("citynexus.demo.journey_id", id);
+  }, journeyId);
+}
+
+export type ProtectedCommitment = {
+  activityId: string;
+  placeId: string;
+  bookingId: string;
+  commitmentId: string | null;
+  amount: unknown;
+};
+
+/**
+ * Create a real protected commitment through the path a traveller would use.
+ *
+ * Measured, not assumed: on the demo plan the cruise activity is `locked: true`
+ * but `protected: false` until a booking exists and its payment is captured —
+ * `protected` is derived from ACTIVE Commitment rows.  So a spec that asserts
+ * "the protected commitment survived the recovery" without creating one is
+ * asserting on a fixture that has nothing to protect, and the flag it reads is
+ * true for the wrong reason.
+ *
+ * Must run before `/start`: booking an activity on a journey that is already
+ * travelling is refused with 422.
+ */
+export async function protectCommitment(
+  request: APIRequestContext,
+  journeyId: string,
+  placeId = "place-river-cruise",
+): Promise<ProtectedCommitment> {
+  const experience = await get<{ active_plan?: { activities?: any[] } }>(
+    request,
+    `/api/v1/journeys/${journeyId}/experience`,
+  );
+  const activity = (experience.active_plan?.activities ?? []).find(
+    (item) => item.place_id === placeId,
+  );
+  if (!activity) {
+    throw new Error(`no activity for ${placeId} on journey ${journeyId} to protect`);
+  }
+
+  const booking = await post<{
+    id: string;
+    commitment_id?: string | null;
+    amount?: unknown;
+  }>(request, `/api/v1/journeys/${journeyId}/bookings`, { activity_id: activity.id });
+  await post(
+    request,
+    `/api/v1/journeys/${journeyId}/transactions`,
+    { booking_id: booking.id, transaction_type: "CAPTURE", amount: booking.amount },
+    { "Idempotency-Key": `protect-${booking.id}` },
+  );
+
+  /* Prove it landed before anything else leans on it. */
+  const after = await get<{ active_plan?: { activities?: any[] } }>(
+    request,
+    `/api/v1/journeys/${journeyId}/experience`,
+  );
+  const projected = (after.active_plan?.activities ?? []).find(
+    (item) => item.place_id === placeId,
+  );
+  if (!projected?.protected) {
+    throw new Error(
+      `booking ${booking.id} + CAPTURE did not make ${placeId} a protected commitment ` +
+        `(locked=${projected?.locked}, protected=${projected?.protected})`,
+    );
+  }
+
+  return {
+    activityId: activity.id,
+    placeId,
+    bookingId: booking.id,
+    commitmentId: booking.commitment_id ?? null,
+    amount: booking.amount,
+  };
+}
diff --git a/frontend/e2e/_qoderRealSeed.setup.ts b/frontend/e2e/_qoderRealSeed.setup.ts
