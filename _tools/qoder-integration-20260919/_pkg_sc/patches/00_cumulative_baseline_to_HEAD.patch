++    left = _Place(None, external_id=None, lat=XIAMEN_LAT, lon=XIAMEN_LON, name=None)
++    right = _Place(None, external_id=None, lat=XIAMEN_LAT, lon=XIAMEN_LON, name=None)
++    assert compare_physical_venue(left, right) == DIFFERENT
++
