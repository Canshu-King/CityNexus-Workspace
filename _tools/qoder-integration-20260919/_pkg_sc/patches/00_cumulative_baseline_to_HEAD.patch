-  const chosenStayPriceKnown = Boolean(
-    chosenStayOption &&
-      ((chosenStayOption.stay?.nightly_amount_minor ?? 0) > 0 ||
-        (chosenStayOption.stay_total_minor ?? 0) > 0),
