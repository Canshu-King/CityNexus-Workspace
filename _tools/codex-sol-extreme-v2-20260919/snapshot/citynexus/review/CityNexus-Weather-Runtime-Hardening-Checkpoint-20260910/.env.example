CITYNEXUS_ENV=development
CITYNEXUS_DATABASE_URL=sqlite:///./citynexus.db
CITYNEXUS_AI_ENABLED=false
CITYNEXUS_AI_PROVIDER=mock-ai
# Optional; when disabled or unavailable, deterministic fallback is used.
# CITYNEXUS_AI_MODEL=deepseek/deepseek-chat
# CITYNEXUS_AI_API_KEY=do-not-commit
CITYNEXUS_CITY_PROVIDER=mock-city
CITYNEXUS_MOBILITY_PROVIDER=mock-mobility
# Optional integration profile only; default tests and demo remain network-free.
# CITYNEXUS_LIVE_VALHALLA_URL=http://localhost:8002
# Server-owned weather refresh only; GET/Twin never calls this provider.
# CITYNEXUS_OPEN_METEO_URL=https://api.open-meteo.com
# CITYNEXUS_OPEN_METEO_TIMEOUT_SECONDS=10
CITYNEXUS_BOOKING_PROVIDER=mock-booking
CITYNEXUS_PAYMENT_PROVIDER=mock-payment
CITYNEXUS_CONTEXT_PROVIDER=mock-context
