diff --git a/frontend/e2e/qoder-ack-rendered.spec.ts b/frontend/e2e/qoder-ack-rendered.spec.ts
new file mode 100644
index 0000000..abc33e1
--- /dev/null
+++ b/frontend/e2e/qoder-ack-rendered.spec.ts
@@ -0,0 +1,334 @@
+/**
+ * T3 — acknowledgement vs resolution (docs/ACK_RESOLUTION_CONTRACT.md).
+ * LAYER: integration (RENDERED component), not unit.
+ *
+ * Unlike e2e/qoder-ack-resolution.spec.ts (which drives the pure predicate via
+ * `page.evaluate(import .../disruptionState.ts)` and is labelled unit), this
+ * spec renders the real React surface: it serves deterministic fixtures through
+ * `page.route` for every API the application actually fetches, boots the real
+ * V8Experience shell on the real `/v8/live` route, and lets the real
+ * `LiveRecovery` component (`src/features/execution/LiveRecovery.tsx`) paint.
+ * The assertions are on rendered DOM (`getByTestId` / `getByText`), never on an
+ * imported function's return value.
+ *
+ * What this pins (the V2-T3 fix — the old `acknowledgedOnly > 0 && openDisruptions
+ * === 0` guard made the "已知晓，仍待处理" notice unreachable, because an
+ * acknowledged-only event is by construction a subset of the open set):
+ *   1. An ACKNOWLEDGED disruption with NO linked ACCEPTED replan stays open, so
+ *      BOTH "发生了什么" (live-disruption) AND "已知晓，仍待处理"
+ *      (live-acknowledged) render at the same time.
+ *   2. An ACCEPTED proposal whose trigger_event_id matches the event closes it:
+ *      neither the open notice nor the acknowledged notice is shown; the event
+ *      surfaces as handled instead.
+ *   3. An ACCEPTED proposal with an UNRELATED trigger_event_id does NOT close the
+ *      event; it stays open (both notices still render).
+ *
+ * Endpoints mocked (the exact URLs LiveRecovery + its V8Experience shell fetch):
+ *   /api/v1/journeys/{id}/experience      (shell `load()` + LiveRecovery disruption
+ *                                          merge of active_plan.disruptions)
+ *   /api/v1/journeys/{id}/replans         (LiveRecovery proposals -> acceptedTriggerIds)
+ *   /api/v1/journeys/{id}/plans           (authoritative plans via useAuthoritativePlans)
+ *   /api/v1/journeys/{id}/twin            (authoritative twin via useAuthoritativeTwin)
+ *   /api/v1/travelers/{id}/agent-policy   (shell boot)
+ *   /api/v1/journeys/{id}/wallet          (shell boot)
+ *   /api/v1/journeys/{id}/offline-snapshot(shell boot; written to Dexie, needs journey_id)
+ *   /api/v1/agent/runtime-status          (shell boot)
+ *   everything else under /api/v1/        (sibling Live / V10 panels) -> {} neutral state
+ */
+
+import { expect, test, type Page } from "@playwright/test";
+
+const JOURNEY_ID = "e2e-render-journey";
+const TRAVELER_ID = "e2e-render-traveler";
+
+/**
+ * Boot the real app in a deterministic, isolated way:
+ *  - seed the journey id the shell reads from localStorage on boot, and force
+ *    the zh-CN locale so the live copy ("发生了什么" / "已知晓，仍待处理") is the
+ *    literal string the review asked to see on screen;
+ *  - neuter the PWA service worker registration so it can never serve a cached
+ *    shell and our route fixtures stay authoritative.
+ */
+async function seed(page: Page) {
+  await page.addInitScript(() => {
+    localStorage.setItem("citynexus.v8.journey_id", "e2e-render-journey");
+    localStorage.setItem("citynexus.locale", "zh-CN");
+    // Prevent the dev service worker from registering / claiming clients.
+    try {
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      (navigator as any).serviceWorker.register = () => Promise.resolve({});
+    } catch {
+      /* no-op */
+    }
+  });
+}
+
+type Disruption = {
+  id: string;
+  type: string;
+  severity: string;
+  status?: string | null;
+  affected_activity_id: string | null;
+  occurred_at: string;
+  resolved_at?: string | null;
+};
+
+type Proposal = {
+  id: string;
+  status: string;
+  trigger_event_id?: string | null;
+  hard_constraints_passed: boolean;
+  locked_commitments_preserved: boolean;
+  diff: { removed?: string[]; added?: string[]; moved?: string[] };
+};
+
+function experienceFixture(disruptions: Disruption[]) {
+  return {
+    journey: {
+      id: JOURNEY_ID,
+      traveler_id: TRAVELER_ID,
+      title: "厦门周末",
+      city_code: "CN-XIAMEN",
+      timezone: "Asia/Shanghai",
+      start_at: "2026-10-09T18:00:00+08:00",
+      end_at: "2026-10-11T15:00:00+08:00",
+      budget: { amount_minor: 120000, currency: "CNY" },
+    },
+    trip: {
+      arrival_anchor: { at: "2026-10-09T18:00:00+08:00", location: "厦门站" },
+      departure_anchor: { at: "2026-10-11T15:00:00+08:00", location: "厦门高崎机场" },
+      party_size: 2,
+      occupancy: { adults: 2, rooms: 1 },
+      stay_budget: { amount_minor: 70000, currency: "CNY" },
+    },
+    offers: [],
+    options: [],
+    selected_option_id: null,
+    mobility_facts: [],
+    active_plan: {
+      id: "plan-1",
+      version_no: 1,
+      status: "ACTIVE",
+      source: "E2E_RENDER",
+      current_activity_id: null,
+      // Deliberately no located activities / legs: keeps MapPanel in its honest
+      // empty state so maplibre never loads external tiles.
+      activities: [],
+      legs: [],
+      user_location: null,
+      disruptions,
+    },
+    recovery: null,
+    experience_flags: {
+      needs_review: false,
+      recovery_required: false,
+      staleness: false,
+      feasibility_failures: [],
+    },
+  };
+}
+
+function offlineFixture() {
+  return {
+    journey_id: JOURNEY_ID,
+    sequence: 1,
+    valid_until: "2026-12-31T00:00:00Z",
+    snapshot: {
+      active_plan_version_id: null,
+      current_activity_id: null,
+      next_24h: [],
+      legs: [],
+      hotel: null,
+      reservations: [],
+      read_only: true,
+      financial_actions_allowed: false,
+    },
+    provider_freshness: { latest_provider_capture_at: null, transit_realtime: "UNKNOWN" },
+    updated_at: "2026-10-09T10:00:00Z",
+  };
+}
+
+/** One dispatcher on /api/v1/ so route-registration order can never bite. */
+async function mockApi(page: Page, fx: { experience: unknown; replans: unknown }) {
+  await page.route(/\/api\/v1\//, (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    const send = (json: unknown) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify(json),
+      });
+    if (pathname.endsWith("/experience")) return send(fx.experience);
+    if (pathname.endsWith("/replans")) return send(fx.replans);
+    if (pathname.endsWith("/plans")) return send([]);
+    if (pathname.endsWith("/twin")) return send({ id: "twin-1", context: {} });
+    if (pathname.endsWith("/agent-policy"))
+      return send({
+        mode: "ADVISORY",
+        auto_accept_replan: false,
+        version: 1,
+        max_auto_replan_cost_delta_minor: 5000,
+        max_auto_loss_minor: 0,
+        max_auto_schedule_drift_min: 20,
+      });
+    if (pathname.endsWith("/wallet"))
+      return send({ reservations: [], commitments: [], offline_ready: true });
+    if (pathname.endsWith("/offline-snapshot")) return send(offlineFixture());
+    if (pathname.endsWith("/runtime-status")) return send({});
+    // The /v8/live route also mounts V10LiveExecutionPanel, which reads
+    // `web.data.observations.length` (not optional beyond web.data) and
+    // `new Date(clock.data.now)`, so these must be well-formed.
+    if (pathname.endsWith("/execution-clock"))
+      return send({ now: "2026-10-09T10:00:00+08:00", timezone: "Asia/Shanghai", current_activity_id: null });
+    if (pathname.endsWith("/web-observations")) return send({ observations: [] });
+    return send({});
+  });
+}
+
+const WEATHER_EVENT: Disruption = {
+  id: "evt-1",
+  type: "WEATHER",
+  severity: "MEDIUM",
+  status: "ACKNOWLEDGED",
+  affected_activity_id: null,
+  occurred_at: "2026-10-09T20:00:00+08:00",
+};
+
+test.describe("T3 acknowledgement vs resolution (rendered integration)", () => {
+  test("an ACKNOWLEDGED disruption with no linked acceptance stays open: both '发生了什么' and '已知晓，仍待处理' render", async ({
+    page,
+  }) => {
+    await seed(page);
+    // No ACCEPTED replan behind the event at all.
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [] });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    // The real LiveRecovery section mounted.
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+
+    // V2-T3 fix: the acknowledged-only notice is now reachable WHILE the event is
+    // still open — the two co-render (the old dead-condition could not).
+    const disruption = page.getByTestId("live-disruption");
+    await expect(disruption).toBeVisible();
+    await expect(disruption).toContainText("发生了什么");
+
+    const acknowledged = page.getByTestId("live-acknowledged");
+    await expect(acknowledged).toBeVisible();
+    await expect(acknowledged).toContainText("已知晓，仍待处理");
+
+    // The traveller has only seen it; nothing is handled yet.
+    await expect(page.getByTestId("live-handled")).toHaveCount(0);
+  });
+
+  test("an ACCEPTED proposal linked to the event by trigger_event_id closes it: no open/acknowledged notice, shown as handled", async ({
+    page,
+  }) => {
+    await seed(page);
+    const accepted: Proposal = {
+      id: "r1",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-1",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [accepted] });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+    // Exact linkage resolves the event -> it is no longer in the open set, so the
+    // "发生了什么" block and the "已知晓，仍待处理" notice both disappear.
+    await expect(page.getByTestId("live-disruption")).toHaveCount(0);
+    await expect(page.getByTestId("live-acknowledged")).toHaveCount(0);
+    await expect(page.getByTestId("live-handled")).toBeVisible();
+  });
+
+  test("an ACCEPTED proposal with an UNRELATED trigger_event_id leaves the event open", async ({
+    page,
+  }) => {
+    await seed(page);
+    const acceptedUnrelated: Proposal = {
+      id: "r2",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-999",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, {
+      experience: experienceFixture([WEATHER_EVENT]),
+      replans: [acceptedUnrelated],
+    });
+    await page.goto("/v8/live", { waitUntil: "domcontentloaded" });
+
+    await expect(page.getByTestId("live-recovery")).toBeVisible();
+    // Accepting a proposal for a DIFFERENT event must not silently resolve this one.
+    await expect(page.getByTestId("live-disruption")).toBeVisible();
+    await expect(page.getByTestId("live-disruption")).toContainText("发生了什么");
+    await expect(page.getByTestId("live-acknowledged")).toBeVisible();
+    await expect(page.getByTestId("live-handled")).toHaveCount(0);
+  });
+});
+
+/**
+ * V3-5: the SAME rule must hold on the Today surface, not only Live.  The
+ * `today-attention` cell in V8Experience counts OPEN disruptions via the shared
+ * `isDisruptionOpen`, so an acknowledged-only event is a countable unresolved
+ * change there too, and a matching accepted replan drops it from the count.
+ */
+test.describe("T3 ack vs resolution — Today surface (rendered integration)", () => {
+  test("an ACKNOWLEDGED event with no acceptance stays an unresolved change on Today", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [] });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    await expect(attention).toContainText("1 项变化");
+  });
+
+  test("a matching ACCEPTED replan clears the change count on Today", async ({ page }) => {
+    await seed(page);
+    const accepted: Proposal = {
+      id: "r1",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-1",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, { experience: experienceFixture([WEATHER_EVENT]), replans: [accepted] });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    // No longer an open/unresolved change once the linked recovery is accepted.
+    await expect(attention).not.toContainText("1 项变化");
+  });
+
+  test("an UNRELATED accepted proposal still leaves the change unresolved on Today", async ({
+    page,
+  }) => {
+    await seed(page);
+    const acceptedUnrelated: Proposal = {
+      id: "r2",
+      status: "ACCEPTED",
+      trigger_event_id: "evt-999",
+      hard_constraints_passed: true,
+      locked_commitments_preserved: true,
+      diff: { removed: [], added: [], moved: [] },
+    };
+    await mockApi(page, {
+      experience: experienceFixture([WEATHER_EVENT]),
+      replans: [acceptedUnrelated],
+    });
+    await page.goto("/v8/today", { waitUntil: "domcontentloaded" });
+
+    const attention = page.getByTestId("today-attention");
+    await expect(attention).toBeVisible();
+    // Accepting a proposal for a DIFFERENT event must not clear this one on Today.
+    await expect(attention).toContainText("1 项变化");
+  });
+});
diff --git a/frontend/e2e/qoder-ack-resolution.spec.ts b/frontend/e2e/qoder-ack-resolution.spec.ts
new file mode 100644
index 0000000..e84e161
--- /dev/null
+++ b/frontend/e2e/qoder-ack-resolution.spec.ts
@@ -0,0 +1,65 @@
+/**
+ * T3 — acknowledgement vs resolution semantics (docs/ACK_RESOLUTION_CONTRACT.md).
+ *
+ * `ACKNOWLEDGED != RESOLVED`.  A disruption the traveller has merely seen must
+ * stay actionable; only RESOLVED, IGNORED, or an accepted replan linked to that
+ * event closes it.  Today and Live must agree on the same event.
+ *
+ * LAYER: unit.  The shared rule lives in a dependency-free module both surfaces
+ * import, so this pins the contract's logic.  A rendered Today/Live integration
+ * test (mocking the experience API so the real components paint) is tracked as a
+ * remaining evidence gap for v2 in the handoff — it is NOT claimed here.
+ */
+
+import { expect, test } from "@playwright/test";
+
+test.describe("T3 acknowledgement vs resolution (unit)", () => {
+  test("acknowledged-only stays open; only linked acceptance resolves", async ({ page }) => {
+    // Serve the module through the Vite dev server so it is transpiled the
+    // same way the application sees it.
+    await page.goto("/");
+    const rules = await page.evaluate(async () => {
+      const mod = await import("/src/lib/disruptionState.ts");
+      const event = { id: "e1", status: "ACKNOWLEDGED", resolved_at: null };
+      const open = mod.isDisruptionOpen(event, new Set());
+      const ackOnly = mod.isDisruptionAcknowledgedOnly(event, new Set());
+      return {
+        acknowledgedOnlyOpen: open,
+        acknowledgedOnlyFlagged: ackOnly,
+        // acknowledged-only is by construction a subset of the open set; the old
+        // UI branch required open===0 too, which could never co-hold.
+        acknowledgedOnlyIsOpenSubset: open && ackOnly,
+        linkedAcceptanceResolves: mod.isDisruptionOpen(event, new Set(["e1"])),
+        resolvedIsClosed: mod.isDisruptionOpen(
+          { id: "e2", status: "RESOLVED", resolved_at: null },
+          new Set(),
+        ),
+        ignoredIsClosed: mod.isDisruptionOpen(
+          { id: "e3", status: "IGNORED", resolved_at: null },
+          new Set(),
+        ),
+        detectedIsOpen: mod.isDisruptionOpen(
+          { id: "e4", status: "DETECTED", resolved_at: null },
+          new Set(),
+        ),
+        unrelatedAcceptanceDoesNotResolve: mod.isDisruptionOpen(event, new Set(["other"])),
+        resolvedAtCloses: mod.isDisruptionOpen(
+          { id: "e5", status: "ACKNOWLEDGED", resolved_at: "2026-09-18T00:00:00Z" },
+          new Set(),
+        ),
+      };
+    });
+
+    expect(rules.acknowledgedOnlyOpen).toBe(true);
+    expect(rules.acknowledgedOnlyFlagged).toBe(true);
+    // The V2 fix drops the impossible `openDisruptions.length === 0` guard so the
+    // "已知晓，仍待处理" notice is reachable while the event is still open.
+    expect(rules.acknowledgedOnlyIsOpenSubset).toBe(true);
+    expect(rules.linkedAcceptanceResolves).toBe(false);
+    expect(rules.resolvedIsClosed).toBe(false);
+    expect(rules.ignoredIsClosed).toBe(false);
+    expect(rules.detectedIsOpen).toBe(true);
+    expect(rules.unrelatedAcceptanceDoesNotResolve).toBe(true);
+    expect(rules.resolvedAtCloses).toBe(false);
+  });
+});
diff --git a/frontend/e2e/qoder-budget-evidence.spec.ts b/frontend/e2e/qoder-budget-evidence.spec.ts
new file mode 100644
index 0000000..b83a1d9
--- /dev/null
+++ b/frontend/e2e/qoder-budget-evidence.spec.ts
@@ -0,0 +1,135 @@
+/**
+ * T4 — budget evidence coverage (docs/BUDGET_EVIDENCE_CONTRACT.md; V2-T4 / B4).
+ *
+ * LAYER: unit.  This drives the pure functions through `page.evaluate(import
+ * .../budgetEvidence.ts)` — real logic, but NOT a rendered component test.  Per
+ * docs/TEST_AND_EVIDENCE_GATE.md it is labelled unit, not E2E.  Rendered Today/
+ * Live and rendered budget-screen integration is tracked as a remaining evidence
+ * gap in the handoff (no jsdom/RTL harness exists in this project).
+ *
+ * "At least one priced stop" is not a budget verdict.  One known price beside
+ * thirteen unknown ones does not verify a total, a zero amount can be *known
+ * free* (real evidence), and — B4 — fourteen priced activities beside an unknown
+ * hotel is NOT a verified trip budget.
+ */
+
+import { expect, test } from "@playwright/test";
+
+test.describe("T4 budget evidence coverage (unit)", () => {
+  test("NONE / PARTIAL / FULL are distinct, and only FULL allows a verdict", async ({ page }) => {
+    await page.goto("/");
+    const result = await page.evaluate(async () => {
+      const mod = await import("/src/lib/budgetEvidence.ts");
+      const unknown = { cost_status: "UNKNOWN", estimated_cost: { amount_minor: 0 } };
+      const paid = (amount) => ({
+        cost_status: "KNOWN_PAID",
+        estimated_cost: { amount_minor: amount },
+      });
+      const free = { cost_status: "KNOWN_FREE", estimated_cost: { amount_minor: 0 } };
+      const unknownList = (n) => Array.from({ length: n }, () => unknown);
+
+      const none = mod.budgetEvidenceCoverage(unknownList(14));
+      const oneOf14 = mod.budgetEvidenceCoverage([paid(3500), ...unknownList(13)]);
+      const thirteenOf14 = mod.budgetEvidenceCoverage([...Array.from({ length: 13 }, () => paid(1000)), unknown]);
+      const allKnown = mod.budgetEvidenceCoverage([paid(1000), free, paid(2000)]);
+      const empty = mod.budgetEvidenceCoverage([]);
+
+      return {
+        noneState: none.state,
+        noneVerdict: mod.budgetVerdictAllowed(none),
+        oneOf14State: oneOf14.state,
+        oneOf14Verdict: mod.budgetVerdictAllowed(oneOf14),
+        oneOf14Unknown: oneOf14.unknownCount,
+        thirteenState: thirteenOf14.state,
+        thirteenVerdict: mod.budgetVerdictAllowed(thirteenOf14),
+        allKnownState: allKnown.state,
+        allKnownVerdict: mod.budgetVerdictAllowed(allKnown),
+        knownFreeCounts: mod.hasReliableCostEvidence(free),
+        zeroWithNoStatus: mod.hasReliableCostEvidence({ estimated_cost: { amount_minor: 0 } }),
+        emptyState: empty.state,
+      };
+    });
+
+    expect(result.noneState).toBe("NONE");
+    expect(result.noneVerdict).toBe(false);
+    expect(result.oneOf14State).toBe("PARTIAL");
+    expect(result.oneOf14Verdict).toBe(false);
+    expect(result.oneOf14Unknown).toBe(13);
+    expect(result.thirteenState).toBe("PARTIAL");
+    expect(result.thirteenVerdict).toBe(false);
+    expect(result.allKnownState).toBe("FULL");
+    expect(result.allKnownVerdict).toBe(true);
+    expect(result.knownFreeCounts).toBe(true);
+    expect(result.zeroWithNoStatus).toBe(false);
+    expect(result.emptyState).toBe("NONE");
+  });
+
+  test("B4: all activities priced but an unknown hotel/booking stays PARTIAL (no trip verdict)", async ({
+    page,
+  }) => {
+    await page.goto("/");
+    const result = await page.evaluate(async () => {
+      const mod = await import("/src/lib/budgetEvidence.ts");
+      const paid = (amount) => ({ cost_status: "KNOWN_PAID", estimated_cost: { amount_minor: amount } });
+      const unknown = { cost_status: "UNKNOWN", estimated_cost: { amount_minor: 0 } };
+
+      // 14 activities, all priced -> activity coverage is FULL...
+      const activitiesOnly = mod.budgetEvidenceCoverage(
+        Array.from({ length: 14 }, () => paid(1000)),
+      );
+      // ...but the whole trip adds an unknown hotel and an unknown transport
+      // booking, so the trip budget must NOT be FULL.
+      const trip = mod.tripBudgetEvidence([
+        { label: "activities", items: Array.from({ length: 14 }, () => paid(1000)) },
+        { label: "stay", items: [unknown] },
+        { label: "transport", items: [unknown] },
+      ]);
+      // And once the hotel + transport are known, the trip can be FULL.
+      const tripComplete = mod.tripBudgetEvidence([
+        { label: "activities", items: [paid(1000)] },
+        { label: "stay", items: [paid(40000)] },
+        { label: "transport", items: [{ cost_status: "KNOWN_FREE", estimated_cost: { amount_minor: 0 } }] },
+      ]);
+      // A positive amount with NO status is displayable but not *verified*, so
+      // an all-statusless plan must not reach FULL (B4 regression 4).
+      const statuslessOnly = mod.budgetEvidenceCoverage([
+        { estimated_cost: { amount_minor: 5000 } },
+        { estimated_cost: { amount_minor: 8000 } },
+      ]);
+
+      return {
+        activitiesOnlyState: activitiesOnly.state,
+        tripState: trip.state,
+        tripVerdict: mod.budgetVerdictAllowed(trip),
+        tripUnknown: trip.unknownCount,
+        tripCompleteState: tripComplete.state,
+        tripCompleteVerdict: mod.budgetVerdictAllowed(tripComplete),
+        statuslessOnlyState: statuslessOnly.state,
+        statuslessOnlyVerdict: mod.budgetVerdictAllowed(statuslessOnly),
+        // B4 wording scope: an activity-only FULL must not be called trip budget.
+        activityScopeClaim: mod.budgetClaimScope(activitiesOnly, false),
+        tripScopeClaimWhenPartial: mod.budgetClaimScope(trip, true),
+        tripScopeClaimWhenFull: mod.budgetClaimScope(tripComplete, true),
+      };
+    });
+
+    // Activity coverage is FULL on its own...
+    expect(result.activitiesOnlyState).toBe("FULL");
+    // ...but the whole-trip aggregation is PARTIAL while hotel + transport unknown.
+    expect(result.tripState).toBe("PARTIAL");
+    expect(result.tripUnknown).toBe(2);
+    expect(result.tripVerdict).toBe(false);
+    // Only after stay + transport are known does the trip reach FULL.
+    expect(result.tripCompleteState).toBe("FULL");
+    expect(result.tripCompleteVerdict).toBe(true);
+    // An all-statusless (no explicit KNOWN status) plan is displayable but not
+    // verified -> PARTIAL, and never a trip-budget verdict (B4 regression 4).
+    expect(result.statuslessOnlyState).toBe("PARTIAL");
+    expect(result.statuslessOnlyVerdict).toBe(false);
+    // Wording scope guards: activity-only is never a trip-budget claim; a
+    // partial trip is never a trip-budget claim; only a full trip may say so.
+    expect(result.activityScopeClaim).toBe("ACTIVITY_COSTS");
+    expect(result.tripScopeClaimWhenPartial).toBe("ACTIVITY_COSTS");
+    expect(result.tripScopeClaimWhenFull).toBe("TRIP_BUDGET");
+  });
+});
diff --git a/frontend/e2e/qoder-budget-rendered.spec.ts b/frontend/e2e/qoder-budget-rendered.spec.ts
new file mode 100644
index 0000000..8a454fb
--- /dev/null
+++ b/frontend/e2e/qoder-budget-rendered.spec.ts
@@ -0,0 +1,233 @@
+/**
+ * T4 — budget evidence coverage (docs/BUDGET_EVIDENCE_CONTRACT.md; V2-T4 / B4).
+ * LAYER: integration (RENDERED component), not unit.
+ *
+ * Unlike e2e/qoder-budget-evidence.spec.ts (which drives the pure functions via
+ * `page.evaluate(import .../budgetEvidence.ts)` and is labelled unit), this spec
+ * renders the real budget surface: it serves deterministic fixtures through
+ * `page.route` for every API the application actually fetches, boots the real
+ * V8Experience shell on the real `/v8/studio` route, and lets the real
+ * `Studio` feasibility block (data-testid="studio-feasibility") paint from the
+ * authoritative plan's activity cost evidence.
+ *
+ * The Studio feasibility block reads `budgetEvidenceCoverage(plan.activities)`
+ * (cost_status / estimated_cost live on the authoritative PlanVersion), and maps
+ * the coverage state to i18n copy:
+ *   FULL    -> studio.feasibilityPassed  ("行程约束检查已通过")
+ *            + studio.feasibilitySub     ("...所有站点的活动费用已完整；整趟行程
+ *                                          预算（含住宿与交通）未在此处验证。")
+ *   PARTIAL -> studio.feasibilityPassedPartial ("行程约束检查通过，费用证据不完整")
+ *            + studio.feasibilityPartialSub    ("...预算未验证：还有 {n} 站没有
+ *                                               供应商价格...")
+ *   NONE    -> studio.feasibilityPassedPartial + studio.feasibilityNoPrice
+ *
+ * What this pins, from the rendered DOM:
+ *   1. B4: everything priced EXCEPT an unknown stay/transport item -> the block
+ *      must NOT carry the FULL verdict wording; it must show the partial
+ *      "预算未验证" wording with the unknown count.
+ *   2. Only when every budget-relevant item is known does the FULL wording appear.
+ *   3. A KNOWN_FREE zero-amount stop counts as *known*, so it does not knock the
+ *      block back out of FULL (a 0 price is real evidence, not "unknown").
+ *
+ * Endpoints mocked: same set the shell boot + Studio consume; the cost evidence
+ * that drives the block is the /api/v1/journeys/{id}/plans response.
+ */
+
+import { expect, test, type Page } from "@playwright/test";
+
+const JOURNEY_ID = "e2e-render-journey";
+const TRAVELER_ID = "e2e-render-traveler";
+
+async function seed(page: Page) {
+  await page.addInitScript(() => {
+    localStorage.setItem("citynexus.v8.journey_id", "e2e-render-journey");
+    localStorage.setItem("citynexus.locale", "zh-CN");
+    try {
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      (navigator as any).serviceWorker.register = () => Promise.resolve({});
+    } catch {
+      /* no-op */
+    }
+  });
+}
+
+/** One plan activity carrying the cost evidence Studio aggregates. */
+function priced(id: string, title: string, cost_status: string, amount_minor: number) {
+  return {
+    id,
+    sequence_no: 1,
+    type: "visit",
+    title,
+    start_at: "2026-10-10T09:00:00+08:00",
+    end_at: "2026-10-10T11:00:00+08:00",
+    locked: false,
+    protected: false,
+    metadata: {},
+    cost_status,
+    estimated_cost: { amount_minor, currency: "CNY" },
+  };
+}
+
+function experienceFixture() {
+  return {
+    journey: {
+      id: JOURNEY_ID,
+      traveler_id: TRAVELER_ID,
+      title: "厦门周末",
+      city_code: "CN-XIAMEN",
+      timezone: "Asia/Shanghai",
+      start_at: "2026-10-09T18:00:00+08:00",
+      end_at: "2026-10-11T15:00:00+08:00",
+      budget: { amount_minor: 120000, currency: "CNY" },
+    },
+    trip: {
+      arrival_anchor: { at: "2026-10-09T18:00:00+08:00", location: "厦门站" },
+      departure_anchor: { at: "2026-10-11T15:00:00+08:00", location: "厦门高崎机场" },
+      party_size: 2,
+      occupancy: { adults: 2, rooms: 1 },
+      stay_budget: { amount_minor: 70000, currency: "CNY" },
+    },
+    offers: [],
+    options: [],
+    selected_option_id: null,
+    mobility_facts: [],
+    active_plan: {
+      id: "plan-1",
+      version_no: 1,
+      status: "ACTIVE",
+      source: "E2E_RENDER",
+      current_activity_id: null,
+      activities: [],
+      legs: [],
+      user_location: null,
+      disruptions: [],
+    },
+    recovery: null,
+    experience_flags: {
+      needs_review: false,
+      recovery_required: false,
+      staleness: false,
+      feasibility_failures: [],
+    },
+  };
+}
+
+function offlineFixture() {
+  return {
+    journey_id: JOURNEY_ID,
+    sequence: 1,
+    valid_until: "2026-12-31T00:00:00Z",
+    snapshot: {
+      active_plan_version_id: null,
+      current_activity_id: null,
+      next_24h: [],
+      legs: [],
+      hotel: null,
+      reservations: [],
+      read_only: true,
+      financial_actions_allowed: false,
+    },
+    provider_freshness: { latest_provider_capture_at: null, transit_realtime: "UNKNOWN" },
+    updated_at: "2026-10-09T10:00:00Z",
+  };
+}
+
+/** Authoritative plan list whose activities carry the cost evidence. */
+function plansFixture(activities: unknown[]) {
+  return [{ id: "plan-1", version_no: 1, status: "ACTIVE", activities }];
+}
+
+async function mockApi(page: Page, activities: unknown[]) {
+  await page.route(/\/api\/v1\//, (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    const send = (json: unknown) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify(json),
+      });
+    if (pathname.endsWith("/experience")) return send(experienceFixture());
+    if (pathname.endsWith("/plans")) return send(plansFixture(activities));
+    if (pathname.endsWith("/replans")) return send([]);
+    if (pathname.endsWith("/twin")) return send({ id: "twin-1", context: {} });
+    if (pathname.endsWith("/agent-policy"))
+      return send({
+        mode: "ADVISORY",
+        auto_accept_replan: false,
+        version: 1,
+        max_auto_replan_cost_delta_minor: 5000,
+        max_auto_loss_minor: 0,
+        max_auto_schedule_drift_min: 20,
+      });
+    if (pathname.endsWith("/wallet"))
+      return send({ reservations: [], commitments: [], offline_ready: true });
+    if (pathname.endsWith("/offline-snapshot")) return send(offlineFixture());
+    if (pathname.endsWith("/runtime-status")) return send({});
+    return send({});
+  });
+}
+
+test.describe("T4 budget evidence coverage (rendered integration)", () => {
+  test("B4: all stops priced but an unknown stay/transport -> the block refuses a verified-budget verdict and shows PARTIAL wording", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 3500),
+      priced("a2", "曾厝垵", "KNOWN_PAID", 1200),
+      priced("a3", "南普陀", "KNOWN_PAID", 800),
+      // The hotel and the airport transfer have no provider price.
+      priced("stay", "住宿 · 酒店", "UNKNOWN", 0),
+      priced("transport", "机场往返交通", "UNKNOWN", 0),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    // PARTIAL wording (positive assertion first, so it waits for the async plan
+    // query to resolve, then the negatives are stable).
+    await expect(block).toContainText("行程约束检查通过，费用证据不完整");
+    await expect(block).toContainText("还有 2 项缺少已验证的供应商价格");
+    // The FULL verdict wording must NOT be shown while stay/transport are unknown.
+    await expect(block).not.toContainText("行程约束检查已通过");
+  });
+
+  test("only when every budget-relevant item is known does the FULL verdict wording render", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 1000),
+      priced("a2", "环岛路骑行", "KNOWN_PAID", 2000),
+      priced("a3", "厦大参观", "KNOWN_PAID", 3000),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    await expect(block).toContainText("行程约束检查已通过");
+    await expect(block).toContainText("所有站点的活动费用已完整");
+    // None of the partial "budget not verified" wording may leak in.
+    await expect(block).not.toContainText("行程约束检查通过，费用证据不完整");
+    await expect(block).not.toContainText("站没有供应商价格");
+  });
+
+  test("a KNOWN_FREE (0 amount) stop counts as known and keeps the block at FULL", async ({
+    page,
+  }) => {
+    await seed(page);
+    await mockApi(page, [
+      priced("a1", "日光岩", "KNOWN_PAID", 1000),
+      priced("free", "南普陀（免费开放）", "KNOWN_FREE", 0),
+      priced("a2", "酒店住宿", "KNOWN_PAID", 5000),
+    ]);
+    await page.goto("/v8/studio", { waitUntil: "domcontentloaded" });
+
+    const block = page.getByTestId("studio-feasibility");
+    await expect(block).toBeVisible();
+    // If a zero-amount KNOWN_FREE fell back to "unknown", coverage would be PARTIAL
+    // and the heading would read "预算未验证". Reaching FULL proves the 0 is evidence.
+    await expect(block).toContainText("行程约束检查已通过");
+    await expect(block).not.toContainText("预算未验证");
+  });
+});
