CITYNEXUS_ENV=development
CITYNEXUS_DATABASE_URL=sqlite:///./citynexus.db
CITYNEXUS_AI_ENABLED=false
CITYNEXUS_AI_PROVIDER=deepseek
CITYNEXUS_AI_MODEL=deepseek-v4-flash
CITYNEXUS_AI_VISION_MODEL=deepseek-v4-flash-vision-exp
# Keep the DeepSeek key in the process environment only.
# CITYNEXUS_AI_API_KEY=
# CITYNEXUS_DEEPSEEK_API_URL=https://api.deepseek.com/responses
# CITYNEXUS_DEEPSEEK_REASONING_EFFORT=high
# CITYNEXUS_DEEPSEEK_WEB_SEARCH=true
# CITYNEXUS_IMPACT_TIMEOUT_SECONDS=10
# Agent calls resolve a server-owned principal. A configured token is required
# outside local loopback development.
# CITYNEXUS_AGENT_TOKEN=
# CITYNEXUS_AGENT_PRINCIPAL_ID=citynexus-local-agent
# CITYNEXUS_AGENT_ALLOWED_TRAVELER_IDS=
CITYNEXUS_CITY_PROVIDER=mock-city
CITYNEXUS_MOBILITY_PROVIDER=mock-mobility
# Optional integration profile only; default tests and demo remain network-free.
# CITYNEXUS_LIVE_VALHALLA_URL=http://localhost:8002
# Server-owned weather refresh only; GET/Twin never calls this provider.
# CITYNEXUS_OPEN_METEO_URL=https://api.open-meteo.com
# CITYNEXUS_OPEN_METEO_TIMEOUT_SECONDS=10
# Optional server-owned Replan candidate generator. Deterministic remains offline-safe default.
CITYNEXUS_SOLVER=deterministic
# CITYNEXUS_SOLVER_RANDOM_SEED=1
# CITYNEXUS_SOLVER_MAX_TIME_SECONDS=1.0
CITYNEXUS_BOOKING_PROVIDER=mock-booking
CITYNEXUS_PAYMENT_PROVIDER=mock-payment
CITYNEXUS_CONTEXT_PROVIDER=mock-context
# Optional Hermes model runtime; the native DeepSeek loop is the fallback.
# CITYNEXUS_HERMES_API_URL=
# CITYNEXUS_HERMES_API_KEY=
# CITYNEXUS_HERMES_MODEL=hermes
# Official native Hermes Runs API. These are loopback/runtime settings, not a new commercial API.
# CITYNEXUS_HERMES_NATIVE_API_URL=http://127.0.0.1:8652
# CITYNEXUS_HERMES_API_SERVER_KEY=<process-only-random-loopback-key>
# CITYNEXUS_HERMES_NATIVE_PROFILE=citynexus
# Optional explicit request override. Leave unset to use the Hermes profile default.
# CITYNEXUS_HERMES_NATIVE_PROVIDER=deepseek
# CITYNEXUS_HERMES_NATIVE_MODEL=deepseek-v4-flash
# Optional Web Push; absent VAPID values use an auditable record fallback.
# CITYNEXUS_VAPID_PUBLIC_KEY=
# CITYNEXUS_VAPID_PRIVATE_KEY=
# CITYNEXUS_VAPID_SUBJECT=mailto:ops@citynexus.local
