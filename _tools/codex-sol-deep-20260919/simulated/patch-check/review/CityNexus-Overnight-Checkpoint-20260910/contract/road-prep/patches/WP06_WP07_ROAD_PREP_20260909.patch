@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Iterable
+
+from app.integrations.context.open_meteo import WeatherRisk
+
+
+@dataclass(frozen=True)
+class WeatherRiskFact:
+    code: str
+    severity: str
+    at: str
+    provider_key: str
+    evidence: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class WeatherSnapshot:
+    provider_key: str
+    captured_at: str
+    facts: tuple[WeatherRiskFact, ...]
+    degraded: bool = False
+
+
+def freeze_weather_risks(
+    risks: Iterable[WeatherRisk],
+    *,
+    provider_key: str = "open-meteo",
+    captured_at: str | None = None,
+    degraded: bool = False,
+) -> WeatherSnapshot:
+    """Freeze external weather output before it becomes CityNexus event evidence."""
+
+    stamp = captured_at or datetime.now(timezone.utc).isoformat()
+    facts = tuple(
+        WeatherRiskFact(
+            code=str(item.code),
+            severity=str(item.severity),
+            at=item.at.isoformat(),
+            provider_key=provider_key,
+            evidence=dict(item.evidence),
+        )
+        for item in sorted(risks, key=lambda row: (row.at, row.code, row.severity))
+    )
+    return WeatherSnapshot(
+        provider_key=provider_key,
+        captured_at=stamp,
+        facts=facts,
+        degraded=degraded,
+    )
+
+
+def provider_verified_event_payload(fact: WeatherRiskFact) -> dict[str, Any]:
+    """Return server-owned evidence for an Event ingestion service.
+
+    This is deliberately not a public EventCreate payload. Public clients must
+    not be able to forge PROVIDER_VERIFIED provenance.
+    """
+
+    return {
+        "provider_key": fact.provider_key,
+        "provenance": "PROVIDER_VERIFIED",
+        "event_type": "WEATHER",
+        "severity": fact.severity,
+        "occurred_at": fact.at,
+        "payload": {
+            "reason_code": fact.code,
+            "provider_evidence": dict(fact.evidence),
+        },
+    }
--- a/backend/app/planning/replan_candidate_problem.py
+++ b/backend/app/planning/replan_candidate_problem.py
@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable
+
+
+@dataclass(frozen=True)
+class ReplanCandidateEvidence:
+    key: str
+    family: str
+    feasible: bool
+    utility_score: float
+    disruption_count: int
+    generation_rank: int
+
+
+def rank_verified_candidates(
+    candidates: Iterable[ReplanCandidateEvidence],
+) -> tuple[ReplanCandidateEvidence, ...]:
+    """Deterministically rank only already-gated candidates.
+
+    OR-Tools may later generate candidates, but it must not bypass this verified
+    evidence boundary or the authoritative CityNexus feasibility gate.
+    """
+
+    feasible = [item for item in candidates if item.feasible]
+    feasible.sort(
+        key=lambda item: (
+            -item.utility_score,
+            item.disruption_count,
+            item.generation_rank,
+            item.family,
+            item.key,
+        )
+    )
+    return tuple(feasible)
+
+
+def take_feasible(
+    candidates: Iterable[ReplanCandidateEvidence], *, candidate_count: int
+) -> tuple[ReplanCandidateEvidence, ...]:
+    if candidate_count < 1:
+        raise ValueError("candidate_count must be positive")
+    return rank_verified_candidates(candidates)[:candidate_count]
