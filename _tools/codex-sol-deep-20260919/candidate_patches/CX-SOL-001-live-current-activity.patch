+/**
+ * Project the authoritative execution cursor into the consumer-facing Live
+ * window. Activities and legs are emitted in sequence order; leg N connects
+ * activity N to N + 1. Falling back to the first activity is only appropriate
+ * before execution has a current cursor, never after the journey advances.
+ */
+function liveActivityWindow(plan: V8Data["active_plan"]) {
+  if (!plan) return { now: null, next: null, nextLeg: null };
+  const cursor = plan.activities.findIndex(
+    (item) => item.id === plan.current_activity_id,
+  );
+  const currentIndex = cursor >= 0 ? cursor : 0;
+  return {
+    now: plan.activities[currentIndex] ?? null,
+    next: plan.activities[currentIndex + 1] ?? null,
+    nextLeg: plan.legs[currentIndex] ?? null,
+  };
+}
